// Small building blocks: icon text, round buttons, chips, toggles, sliders.

import { Theme, Clock, Act } from "theme.slint";

// A bottom sheet that follows the finger (spec 26): its scrim, the handle and the sheet; the content goes in as
// children (drawn from the sheet's top, `need` high). It opens with a small spring, follows a drag on the handle
// strip and the header (top 64 px) 1:1, stretches at most 24 px above its height (rubber band), and on release
// closes (a flick down faster than 0.5 px/ms, or pulled past min(30 % of its height, 120 px)) or springs back
// from where the finger left it. The scrim fades with the visible part; a tap on it closes the sheet.
export component DragSheet inherits Rectangle {
    in property <bool> open;
    in property <length> need;                   // the sheet's height (sized to its content)
    in property <color> sheet-color: Theme.surface;
    in property <color> ink: Theme.text;          // the handle's colour (the sheet's text colour)
    callback close();                            // a tap on the scrim, or the sheet dragged away
    in property <bool> dismissable: true;        // false: it follows the finger with the rubber band and springs back
    in property <float> scrim-alpha: 0.5;
    in property <length> grab: 64px;             // the strip at the top that drags the sheet
    out property <bool> shown: root.open || root.close-k < 0.999;
    // open: the M3 spring (300 ms, a 3 px overshoot); close: 200 ms ease-in
    property <float> open-k: root.open ? 1 : 0;
    animate open-k { duration: root.open ? 300ms : 0ms; easing: cubic-bezier(0.34, 1.25, 0.64, 1); }
    property <float> close-k: root.open ? 0 : 1;
    animate close-k { duration: root.open ? 0ms : 200ms; easing: cubic-bezier(0.4, 0, 1, 1); }
    property <length> travel: root.need + 24px;
    property <length> slide: root.open ? (1 - root.open-k) * root.travel : root.close-k * root.travel;
    // the drag: the finger's offset (down +), the rubber band above; after release it moves to its target
    property <bool> held;
    property <bool> snap;                        // set the drag without motion (a fresh opening)
    property <length> drag;
    property <duration> drag-ms: 300ms;
    animate drag { duration: root.held || root.snap ? 0ms : root.drag-ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> last-y;
    property <duration> last-t;
    property <float> vel;                        // px per ms, + downwards, over the last movement
    property <bool> leaving;
    changed open => {
        if root.open {
            root.snap = true;
            root.drag = 0px;
            root.leaving = false;
            root.snap = false;
        }
    }
    pure function band(d: length) -> length {
        // above the sheet's height: 24 px · (1 − e^(−d / 80 px))
        return -24px * (1 - Math.pow(2.71828, -(d / 80px)));
    }
    Timer {
        interval: root.drag-ms + 20ms;
        running: root.leaving;
        triggered => {
            root.leaving = false;
            root.close();
        }
    }
    property <length> visible-h: Math.max(0px, root.need - root.slide - Math.max(0px, root.drag));
    Rectangle {
        visible: root.shown;
        background: #000000;
        opacity: root.scrim-alpha * Math.min(1, root.visible-h / Math.max(1px, root.need));
        TouchArea {
            enabled: !root.held;
            clicked => { if root.dismissable { root.close(); } }
        }
    }
    sheet := Rectangle {
        visible: root.shown;
        x: 0; y: root.height - root.need + root.slide + root.drag; width: root.width; height: root.need + 24px;
        border-radius: 24px; background: root.sheet-color;
        TouchArea { }
        // the handle: 36 × 4 at 30 %, 52 × 5 at 55 % while held
        property <bool> wide: root.held;
        Rectangle {
            property <float> hk: sheet.wide ? 1 : 0;
            animate hk { duration: sheet.wide ? 120ms : 160ms; easing: ease-out; }
            x: (parent.width - (36px + 16px * self.hk)) / 2; y: 8px - 0.5px * self.hk;
            width: 36px + 16px * self.hk; height: 4px + 1px * self.hk; border-radius: 2.5px;
            background: root.ink.with-alpha(0.3 + 0.25 * self.hk);
        }
        grab-ta := TouchArea {
            x: 0; y: 0; width: parent.width; height: root.grab;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.held = true;
                    root.last-y = self.mouse-y;
                    root.last-t = animation-tick();
                    root.vel = 0;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.held {
                    root.held = false;
                    // the decision: a flick down, or far enough down → close; else back to the sheet's height
                    if root.dismissable && (root.vel > 0.5 || root.drag > Math.min(root.need * 0.3, 120px)) {
                        let remaining = root.travel - root.drag;
                        root.drag-ms = root.vel > 0.8 ? Math.max(90ms, Math.min(200ms, (remaining / 1px) / root.vel * 1ms)) : 200ms;
                        root.drag = root.travel;
                        root.leaving = true;
                    } else {
                        root.drag-ms = Math.abs(root.vel) > 0.8 ? 220ms : 300ms;
                        root.drag = 0px;
                    }
                }
            }
            moved => {
                if root.held {
                    let dy = self.mouse-y - self.pressed-y;
                    let raw = root.dismissable ? dy : Math.min(dy, 24px);
                    root.drag = raw >= 0 ? raw : root.band(-raw);
                    // velocity over the latest movement (at least 16 ms apart), smoothed
                    let dt = (animation-tick() - root.last-t) / 1ms;
                    if dt >= 16 {
                        root.vel = root.vel * 0.4 + 0.6 * ((self.mouse-y - root.last-y) / 1px) / dt;
                        root.last-y = self.mouse-y;
                        root.last-t = animation-tick();
                    }
                }
            }
        }
        @children
    }
}

// A news crawl: the text rolls on from right to left without end, drawn twice for a seamless loop. A new text
// joins at the tail (never under the eye); a new `epoch` starts it afresh (bumped while its page is out of sight).
export component Crawl inherits Rectangle {
    in property <string> text;
    in property <int> epoch;
    in property <length> font-size: 13px;
    in property <int> font-weight: 700;
    in property <string> font-family;
    in property <length> letter-spacing: 0;
    in property <color> ink;
    in property <float> speed: 0.07;       // px per ms
    clip: true;
    // the gap between the copies is the app's own separator ("   •   "), so the seam looks like every other joint
    sep-probe := Text { visible: false; text: "a   \u{2022}   a"; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; }
    pair-probe := Text { visible: false; text: "aa"; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; }
    property <length> gap: sep-probe.preferred-width - pair-probe.preferred-width;
    property <string> lead;                // the copy in front
    property <string> tail;                // the copy behind it
    property <duration> t0;
    // a copy never shorter than the strip, so the strip is never half empty
    property <length> span: max(lead-text.preferred-width, root.width) + root.gap;
    property <length> off: (animation-tick() - root.t0) / 1ms * root.speed * 1px;
    function restart() {
        root.lead = root.text;
        root.tail = root.text;
        root.t0 = animation-tick();
    }
    init => { root.restart(); }
    changed epoch => { root.restart(); }
    changed text => {
        if root.lead == "" {
            root.restart();
        } else if root.span - root.off > root.width {
            root.tail = root.text;
        }
    }
    // when the front copy has rolled out, the one behind leads and the newest text follows it (a late look only
    // moves the swap into the gap: the picture does not jump)
    Timer {
        interval: 250ms;
        running: root.lead != "";
        triggered => {
            if root.off >= root.span {
                root.t0 += root.span / 1px / root.speed * 1ms;
                root.lead = root.tail;
                root.tail = root.text;
            }
        }
    }
    lead-text := Text { x: -root.off; y: 0; height: root.height; text: root.lead; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; color: root.ink; vertical-alignment: center; }
    Text { x: root.span - root.off - root.gap / 2 - self.preferred-width / 2; y: 0; height: root.height; text: "\u{2022}"; font-size: root.font-size;
        font-weight: root.font-weight; font-family: root.font-family; color: root.ink; vertical-alignment: center; }
    Text { x: root.span - root.off; y: 0; height: root.height; text: root.tail; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; color: root.ink; vertical-alignment: center; }
}

// The play triangle sits 1/16 em right of the middle in the icon font (its box: 171..405 of 512): an icon in a
// round button moves it back by this much, so play and pause are both in the middle of the circle.
export global Glyph {
    pure public function nudge(text: string, size: length) -> length {
        return text == "\u{F040A}" ? -size * 0.0625 : 0px;
    }
}

// Play / pause as one shape (M13): the play triangle (38,28) (68,48) (38,68) in a 96 px square, its centroid in
// the middle, split at x 53 into two quads that morph into the pause bars (34–44 and 52–62, y 30–66) in 160 ms.
export component PlayGlyph inherits Rectangle {
    in property <bool> playing;          // true: the pause bars (it plays), false: the play triangle
    in property <color> ink: #ffffff;
    property <float> k: root.playing ? 1 : 0;
    animate k { duration: 160ms; easing: ease-in-out; }
    pure function m(a: float, b: float) -> float { return a + (b - a) * root.k; }
    Path {
        width: root.width; height: root.height; viewbox-width: 96; viewbox-height: 96; fill: root.ink;
        MoveTo { x: root.m(38, 34); y: root.m(28, 30); }
        LineTo { x: root.m(53, 44); y: root.m(38, 30); }
        LineTo { x: root.m(53, 44); y: root.m(58, 66); }
        LineTo { x: root.m(38, 34); y: root.m(68, 66); }
        Close { }
        MoveTo { x: root.m(53, 52); y: root.m(38, 30); }
        LineTo { x: root.m(68, 62); y: root.m(48, 30); }
        LineTo { x: root.m(68, 62); y: root.m(48, 66); }
        LineTo { x: root.m(53, 52); y: root.m(58, 66); }
        Close { }
    }
}

export component Icon inherits Text {
    font-family: "Material Design Icons";
    // No layer of its own: a cached Text item kept showing the old glyph after
    // its text changed (play / pause), and a glyph is cheap on the GPU.
    horizontal-alignment: center;
    vertical-alignment: center;
}

// White text over the weather picture with a soft dark rim hugging the glyphs: four faint copies
// offset diagonally (a little more downwards). Readable over white clouds without a dark patch
// behind it. (The software renderer ignores Text stroke, so the rim is drawn this way.)
// k: strength (0 = plain text); icon: use the icon font.
export component GlowText {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k: 1;
    in property <bool> icon;
    in property <string> family;      // another font (e.g. the to-do terminal look's monospace); empty: the default
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextOverflow> overflow: clip;
    // neon letters (home page, synthwave background): a coloured glow around the letters and a
    // firm dark rim instead of the soft one (as the timers page's synthwave theme)
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    // Text that changes every second (time labels): drawn directly. Any other
    // text is drawn once into its own layer: the rim copies cost nothing then.
    in property <bool> live;
    cache-rendering-hint: !root.live;
    property <length> d: max(0.8px, min(2.2px, root.font-size / 46));
    in property <bool> paper;          // dark text on a light scene: a Paper rim instead of the dark one
    property <color> rim: root.paper ? #F5F3EE.with-alpha(0.55 * min(1, root.k)) : #000000.with-alpha(0.18 * min(1, root.k));
    // the glow: one ring of copies just outside the thin dark rim, enough to show on every background
    // without turning into a halo (two rings are too much neon); the rim keeps the letters
    // readable on bright skies
    property <length> gi: max(1.8px, min(5px, root.font-size / 22));
    property <length> nr: max(0.7px, min(1.6px, root.font-size / 48));
    property <float> neon-rim: 0;     // the dark rim under the glow: off (no black frame with neon)
    preferred-width: t.preferred-width;
    preferred-height: t.preferred-height;
    min-height: t.preferred-height;
    for o in [{ x: -1, y: 0 }, { x: 1, y: 0 }, { x: 0, y: -1 }, { x: 0, y: 1 }, { x: -0.71, y: -0.71 }, { x: 0.71, y: -0.71 }, { x: -0.71, y: 0.71 }, { x: 0.71, y: 0.71 }]: Text {
        visible: root.neon;
        x: o.x * root.gi; y: o.y * root.gi; width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.glow.with-alpha(0.24);
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow;
    }
    for o in [{ x: -1, y: -1 }, { x: 1, y: -1 }, { x: -1, y: 1 }, { x: 1, y: 1 }, { x: 0, y: -1.4 }, { x: 0, y: 1.4 }, { x: -1.4, y: 0 }, { x: 1.4, y: 0 }]: Text {
        visible: root.neon && root.neon-rim > 0;
        x: o.x * root.nr; y: o.y * root.nr; width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.glow.mix(#000000, 0.22).with-alpha(0.85 * root.neon-rim);
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow;
    }
    for o in [{ x: -1, y: -0.35 }, { x: 1, y: -0.35 }, { x: -1, y: 1.5 }, { x: 1, y: 1.5 }]: Text {
        visible: root.k > 0.01 && !root.neon;
        x: o.x * root.d; y: o.y * root.d; width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.rim;
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow;
    }
    t := Text {
        width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.color;
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow;
    }
    // neon: a hot, whiter core (as a lit tube) — coloured letters turn pastel and stand out from a glow
    // of their own colour on a sky of the same hue; white letters stay white
    if root.neon: Text {
        width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: #ffffff73;
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow;
    }
}

// A text line for titles: when it does not fit, it is either cut off with … or, with `scroll`, it
// runs to the left in a loop (holds 1.5 s at the start of each round). speed 1..5 = slow..fast.
// Short texts never move. k = GlowText rim (0 = plain).
component MarqueeLine {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <bool> scroll;
    in property <float> speed: 3;
    in property <duration> t0;             // when this text came: its scroll starts from the beginning there
    property <length> tw: probe.preferred-width;
    property <bool> moving: root.scroll && self.tw > root.width;
    property <length> gap: 48px;
    property <float> v: root.speed <= 1 ? 14 : root.speed <= 2 ? 22 : root.speed <= 3 ? 32 : root.speed <= 4 ? 46 : 64;   // px / s
    property <float> period: (self.tw + self.gap) / 1px / self.v + 1.5;                                                  // s
    property <float> t: Math.mod(max(0, (animation-tick() - root.t0) / 1ms / 1000), self.period);
    property <length> off: max(0, self.t - 1.5) * self.v * 1px;
    probe := Text { visible: false; text: root.text; font-size: root.font-size; font-weight: root.font-weight; }
    Rectangle {
    clip: root.moving;
    if !root.moving: GlowText {
        width: root.width; height: root.height; text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; horizontal-alignment: root.horizontal-alignment; overflow: elide;
    }
    if root.moving: GlowText {
        x: -root.off; width: root.tw; height: root.height; text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow;
    }
    if root.moving: GlowText {
        x: -root.off + root.tw + root.gap; width: root.tw; height: root.height; text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow;
    }
    }
}

export component Marquee {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <bool> scroll;
    in property <float> speed: 3;
    // a new text fades in over the old one (250 ms), two lines
    property <string> ta: root.text;
    property <string> tb;
    property <duration> ta0: Clock.base;
    property <duration> tb0;
    property <bool> on-b;
    changed text => {
        if root.on-b { root.ta = root.text; root.ta0 = animation-tick(); root.on-b = false; }
        else { root.tb = root.text; root.tb0 = animation-tick(); root.on-b = true; }
    }
    property <float> kb: root.on-b ? 1 : 0;
    animate kb { duration: 250ms; easing: ease-in-out; }
    if root.kb < 0.999: MarqueeLine {
        width: root.width; height: root.height; opacity: 1 - root.kb;
        text: root.ta; t0: root.ta0; font-size: root.font-size; font-weight: root.font-weight; color: root.color; k: root.k;
        neon: root.neon; glow: root.glow; horizontal-alignment: root.horizontal-alignment; scroll: root.scroll; speed: root.speed;
    }
    if root.kb > 0.001: MarqueeLine {
        width: root.width; height: root.height; opacity: root.kb;
        text: root.tb; t0: root.tb0; font-size: root.font-size; font-weight: root.font-weight; color: root.color; k: root.k;
        neon: root.neon; glow: root.glow; horizontal-alignment: root.horizontal-alignment; scroll: root.scroll; speed: root.speed;
    }
}

// The LAUDEN logo mark (red disc with the house), from assets/logo.svg.
// The software renderer fills paths non-zero only, so the even-odd cut-outs
// of the SVG are drawn as layers: disc, house lines, house inside.
export component LogoMark inherits Rectangle {
    // the PanelOS mark: P in Morse in two rows (dot dash / dash dot); dots Signal, dashes the text colour of the ground
    in property <length> size: 32px;
    in property <color> lines: Theme.text;    // the dashes
    in property <color> disc: Theme.brand;    // the dots (grey while the panel is offline)
    property <length> u: self.size / 10;
    width: self.size;
    height: self.size;
    Rectangle { x: 0; y: (root.size - root.u * 6) / 2; width: root.size; height: root.u * 6;
        Rectangle { x: 0; y: 0; width: root.u * 2; height: root.u * 2; border-radius: root.u; background: root.disc; }
        Rectangle { x: root.u * 4; y: 0; width: root.u * 6; height: root.u * 2; border-radius: root.u; background: root.lines; }
        Rectangle { x: 0; y: root.u * 4; width: root.u * 6; height: root.u * 2; border-radius: root.u; background: root.lines; }
        Rectangle { x: root.u * 8; y: root.u * 4; width: root.u * 2; height: root.u * 2; border-radius: root.u; background: root.disc; }
    }
}

// Three-way theme switch: 0 light, 1 dark, 2 auto (light sensor).
component ThemeSegment inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: 18px;
    // Brand: Signal is never a ground for text. The chosen one is set off in
    // the text colour (Ink on light, Paper on dark); its icon is lit in Signal.
    background: root.selected ? Theme.text : (t.pressed ? Theme.surface-pressed : transparent);
    t := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        Icon { text: root.icon; font-size: 18px; color: root.selected ? Theme.accent : Theme.muted; }
        Text {
            text: root.label;
            font-size: Theme.font-label;
            font-weight: root.selected ? Theme.weight-strong : Theme.weight-regular;
            color: root.selected ? Theme.background : Theme.muted;
            vertical-alignment: center;
        }
    }
}


// the app icon's shape: a superellipse (n = 4, continuous curvature, every side gently curved)
export component Squircle inherits Path {
    in property <color> tone;
    viewbox-width: 100; viewbox-height: 100;
    fill: root.tone;
