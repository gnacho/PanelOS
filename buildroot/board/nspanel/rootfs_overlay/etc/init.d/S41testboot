#!/bin/sh
# Safety net for one-shot test boots. A new image is first booted once with
# the misc boot command cleared ("nspanel-bootmode android", then
# "reboot-to recovery"). If such a boot gets no network within 90 s, reboot:
# the boot partition starts (the stock Android, or once Android is removed the
# second PanelOS copy) and the previous image can be written back over ADB or
# SSH without anyone at the panel. Normal boots (default boot = open system)
# never reboot.

log() { echo "<4>nspanel-testboot: $*" > /dev/kmsg; }

case "$1" in
start)
	nspanel-bootmode status 2>/dev/null | grep -q "open system" && exit 0
	log "test boot (default boot is not the open system): rebooting if there is no network within 90 s"
	(
		i=0
		while [ $i -lt 90 ]; do
			ip -4 -o addr show dev wlan0 2>/dev/null | grep -q " inet " && { log "network up, test boot kept"; exit 0; }
			sleep 1
			i=$((i + 1))
		done
		log "no network after 90 s, rebooting to the boot partition"
		sync
		reboot
	) &
	;;
stop | restart | reload)
	;;
esac
exit 0
