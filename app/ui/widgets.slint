 97.20 16.31 L 97.65 17.65 L 98.06 19.07 L 98.43 20.58 L 98.76 22.21 L 99.05 23.95 L 99.30 25.84 L 99.52 27.92 L 99.69 30.22 L 99.83 32.86 L 99.92 35.99 L 99.98 40.09 Z";
}

// the settings button: the PanelOS mark on the app icon's shape (never a gear)
export component MarkButton inherits Rectangle {
    in property <length> size: 44px;
    callback clicked;
    width: self.size;
    height: self.size;
    Squircle { width: root.size; height: root.size; tone: touch.pressed ? Theme.button-pressed : Theme.button; }
    touch := TouchArea { clicked => { root.clicked(); } }
    LogoMark { x: (root.size - self.width) / 2; y: (root.size - self.height) / 2; size: root.size * 0.58; }
}

// the mark as a signal: its four parts light up one after another in Morse rhythm (dot, dash, dash, dot), each fading
// like an ember after it went out; the app drives `t` (seconds). Offline: slower, and the parts never fully dark.
export component MorseMark inherits Rectangle {
    in property <length> size: 120px;
    in property <float> t;
    in property <bool> slow;
    in property <color> dot-col: Theme.brand;
    in property <color> dash-col: Theme.text;
    property <length> u: self.size / 10;
    property <float> unit: root.slow ? 0.42 : 0.2;                 // one Morse unit in seconds
    property <float> ph: Math.mod(root.t / root.unit, 18);          // dot 1, gap 1, dash 3, gap 1, dash 3, gap 1, dot 1, pause 7
    property <float> base: root.slow ? 0.30 : 0.16;
    pure function lvl(start: float, len: float) -> float {
        root.ph < start ? 0.0 : root.ph < start + len ? 1.0 : max(0.0, 1.0 - (root.ph - start - len) / 3.0)
    }
    property <float> l0: root.lvl(0, 1);
    property <float> l1: root.lvl(2, 3);
    property <float> l2: root.lvl(6, 3);
    property <float> l3: root.lvl(10, 1);
    width: self.size;
    height: self.size;
    for e in [{ x: 0, y: 0, w: 2, dot: true, l: root.l0 }, { x: 4, y: 0, w: 6, dot: false, l: root.l1 },
              { x: 0, y: 4, w: 6, dot: false, l: root.l2 }, { x: 8, y: 4, w: 2, dot: true, l: root.l3 }]: Rectangle {
        property <color> c: e.dot ? root.dot-col : root.dash-col;
        x: e.x * root.u; y: (root.size - root.u * 6) / 2 + e.y * root.u; width: e.w * root.u; height: root.u * 2;
        Rectangle { x: -root.u * 1.6; y: -root.u * 1.6; width: parent.width + root.u * 3.2; height: parent.height + root.u * 3.2; border-radius: root.u * 2.6;
            background: parent.c.with-alpha(0.10 * e.l); }
        Rectangle { x: -root.u * 0.8; y: -root.u * 0.8; width: parent.width + root.u * 1.6; height: parent.height + root.u * 1.6; border-radius: root.u * 1.8;
            background: parent.c.with-alpha(0.22 * e.l); }
        Rectangle { border-radius: root.u; background: parent.c.with-alpha(root.base + (1 - root.base) * e.l); }
    }
}

export component ThemeSwitch inherits Rectangle {
    in property <int> selected: 2;
    callback changed(int);
    height: 40px;
    border-radius: 20px;
    background: Theme.surface;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        ThemeSegment { icon: "\u{F05A8}"; label: "Light"; selected: root.selected == 0; clicked => { root.changed(0); } }
        ThemeSegment { icon: "\u{F0594}"; label: "Dark"; selected: root.selected == 1; clicked => { root.changed(1); } }
        ThemeSegment { icon: "\u{F050E}"; label: "Auto"; selected: root.selected == 2; clicked => { root.changed(2); } }
    }
}

export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.text;
    in property <length> size: 44px;
    callback clicked;
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: touch.pressed ? Theme.button-pressed : Theme.button;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Icon {
        x: Glyph.nudge(root.icon, root.size * 0.55); width: parent.width; height: parent.height;
        text: root.icon;
        font-size: root.size * 0.55;
        color: root.tint;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text;
    in property <bool> danger: false;
    callback clicked;
    height: 48px;
    border-radius: 14px;
    background: touch.pressed ? Theme.button-pressed : Theme.button;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        text: root.text;
        font-size: 16px;
        color: root.danger ? #ef4444 : root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 40px;
    min-width: label.preferred-width + 28px;
    border-radius: 20px;
    background: root.selected ? Theme.accent.with-alpha(0.22) : (touch.pressed ? Theme.button-pressed : Theme.chip);
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.chip-border;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: 15px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A horizontally scrolling row of chips; `selected` is an index (-1 = none).
export component ChipRow inherits Flickable {
    in property <[string]> items;
    in property <int> selected: -1;
    callback picked(int);
    height: 44px;
    content-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        for item[i] in root.items: Chip {
            text: item;
            selected: i == root.selected;
            clicked => { root.picked(i); }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled;
    width: 56px;
    height: 32px;
    border-radius: 16px;
    background: root.on ? Theme.accent : Theme.button-pressed;
    animate background { duration: 150ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: #ffffff;
        animate x { duration: 150ms; }
    }
    TouchArea {
        clicked => { root.toggled(); }
    }
}

// Large touch slider. `value` (0..1) comes from Home Assistant; while the
// finger is down the slider follows it and `changed` fires on release.
// unit: 0 = percent, 1 = kelvin (min-value..max-value), 2 = no number.
export component BigSlider inherits Rectangle {
    in property <float> value;
    in property <string> title;
    in property <brush> track: Theme.button;
    in property <brush> fill: Theme.accent;
    in property <bool> show-fill: true;
    in property <int> unit: 0;
    in property <int> min-value: 0;
    in property <int> max-value: 100;
    callback changed(float);
    // let go: the slider keeps the dropped value until the device's value follows (or 3 s), then glides
    // into it (no snap back and forth)
    property <bool> holding;
    property <float> held;
    changed value => { root.holding = false; }
    Timer { interval: 3s; running: root.holding; triggered => { root.holding = false; } }
    property <float> live: touch.pressed ? max(0, min(1, touch.mouse-x / self.width)) : root.holding ? root.held : root.value;
    animate live { duration: touch.pressed ? 0ms : 200ms; easing: ease-out; }
    height: 56px;
    border-radius: 16px;
    background: root.track;
    clip: true;
    if root.show-fill: Rectangle {
        x: 0;
        width: parent.width * root.live;
        height: parent.height;
        background: root.fill;
    }
    if !root.show-fill: Rectangle {
        x: max(4px, min(parent.width - 10px, parent.width * root.live - 3px));
        y: 6px;
        width: 6px;
        height: parent.height - 12px;
        border-radius: 3px;
        background: #ffffff;
        border-width: 1px;
        border-color: #00000055;
    }
    Text {
        x: 16px;
        text: root.unit == 0 ? root.title + "   " + round(root.live * 100) + " %"
            : root.unit == 1 ? root.title + "   " + round(root.min-value + root.live * (root.max-value - root.min-value)) + " K"
            : root.title;
        font-size: 16px;
        // Gradient tracks (colour temperature, colour) are light at the left: dark text.
        color: !root.show-fill ? #111827 : (root.live > 0.25 ? #ffffff : Theme.text);
        vertical-alignment: center;
    }
    touch := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.holding = true;
                root.changed(root.held);
            }
        }
    }
}
