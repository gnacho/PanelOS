// Music page: what plays on the chosen Music Assistant player, in one of five looks:
//   0 plain (blurred cover behind), 1 full-screen cover (top / bottom fade to dark or light),
//   2 turntable (cover = label, tone arm = position), 3 cassette, 4 half cassette.
// The accent (bars, play button, vinyl, label stripes) and the blurred background are computed by
// the app once per track. The speaker chip opens the player picker.
// The software renderer can't rotate images or clip to a circle, so the vinyl hole is a thick round
// border over the square cover, and the tone arm / tape run are paths computed here.
import { Theme, Act } from "theme.slint";
import { Icon, GlowText, Marquee } from "widgets.slint";

export struct MusicPlayer {
    name: string,       // "Kitchen speaker"
    icon: string,       // speaker, display, TV …
    active: bool,       // the page shows / controls this one
    grouped: bool,      // plays together with the active one
    playing: bool,      // plays something (maybe something else)
    now: string,        // what it plays ("Go West · Pet Shop Boys"), empty when idle
}

component Ctl inherits Rectangle {
    in property <string> icon;
    in property <length> size: 48px;
    in property <length> icon-size: 32px;
    in property <bool> on: true;           // shuffle / repeat state
    in property <color> accent;
    in property <color> ink: #ffffff;
    in property <bool> toggle;             // shows the on state with the accent and a dot
    in property <string> act;              // what a tap does (Act)
    width: self.size; height: self.size;
    opacity: touch.pressed ? 0.55 : 1;
    touch := TouchArea { x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px; clicked => { if root.act != "" { Act.act(root.act, ""); } } }
    Icon { text: root.icon; font-size: root.icon-size; color: root.toggle && root.on ? root.accent : root.toggle ? root.ink.with-alpha(0.5) : root.ink; }
    if root.toggle && root.on: Rectangle { x: (parent.width - 4px) / 2; y: parent.height - 4px; width: 4px; height: 4px; border-radius: 2px; background: root.accent; }
}

// Follows the finger while it is down (the app's value otherwise); `done` with
// the value where the finger lifted.
component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill;
    in property <color> track;
    in property <color> knob;
    callback done(float);
    property <float> drag-v;
    property <float> shown: touch.pressed ? root.drag-v : root.value;
    height: 4px; border-radius: 2px; background: root.track;
    Rectangle { x: 0; width: parent.width * root.shown; border-radius: 2px; background: root.fill; }
    Rectangle { x: parent.width * root.shown - 6px; y: -4px; width: 12px; height: 12px; border-radius: 6px; background: root.knob; }
    touch := TouchArea {
        x: -10px; y: -18px; width: parent.width + 20px; height: parent.height + 36px;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.drag-v = max(0, min(1, (self.mouse-x - 10px) / root.width));
            } else if ev.kind == PointerEventKind.up {
                root.done(root.drag-v);
            }
        }
        moved => { root.drag-v = max(0, min(1, (self.mouse-x - 10px) / root.width)); }
    }
}

// [elapsed][—— bar ——][remaining] and [speaker 37 %][—— bar ——]: both bars equally long.
component BarRows inherits Rectangle {
    in property <float> pos;
    in property <float> dur;
    in property <float> volume;
    in property <length> row1;             // centre line of the time row
    in property <length> row2;             // centre line of the volume row
    in property <color> fill;
    in property <color> vol-fill;
    in property <color> track;
    in property <color> knob;
    in property <color> ink;
    in property <color> soft;
    in property <length> lpad: 20px;       // left label column
    in property <length> colw: 64px;
    in property <length> rpad: 20px;
    property <length> bx: root.lpad + root.colw + 12px;
    property <length> bw: root.width - root.bx - root.rpad - root.colw - 12px;
    pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
    pure function mmss(t: float) -> string {
        t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(t / 60), 60)) + ":" + root.two(Math.mod(Math.floor(t), 60))
            : Math.floor(t / 60) + ":" + root.two(Math.mod(Math.floor(t), 60))
    }
    if root.dur > 0: Text { x: root.lpad; y: root.row1 - 10px; width: root.colw; height: 20px; text: root.mmss(root.pos); font-size: 13px; color: root.soft; horizontal-alignment: right; vertical-alignment: center; }
    if root.dur > 0: Bar { x: root.bx; y: root.row1 - 2px; width: root.bw; value: max(0, min(1, root.pos / root.dur)); fill: root.fill; track: root.track; knob: root.knob;
        done(v) => { Act.act("music.seek", v * root.dur); } }
    if root.dur > 0: Text { x: root.bx + root.bw + 12px; y: root.row1 - 10px; width: root.colw; height: 20px; text: "−" + root.mmss(max(0, root.dur - root.pos)); font-size: 13px; color: root.soft; vertical-alignment: center; }
    if root.dur <= 0: Rectangle {
        x: (root.width - 52px) / 2; y: root.row1 - 10px; width: 52px; height: 20px; border-radius: 10px; background: root.fill.with-alpha(0.25);
        Text { text: "LIVE"; font-size: 11px; font-weight: 700; color: root.ink; horizontal-alignment: center; vertical-alignment: center; }
    }
    Icon { x: root.lpad; y: root.row2 - 10px; width: root.colw; height: 20px; horizontal-alignment: right;
        text: root.volume <= 0 ? "\u{F0581}" : root.volume > 0.6 ? "\u{F057E}" : root.volume > 0.25 ? "\u{F0580}" : "\u{F057F}"; font-size: 18px; color: root.soft; }
    Bar { x: root.bx; y: root.row2 - 2px; width: root.bw; value: root.volume; fill: root.vol-fill; track: root.track; knob: root.knob;
        done(v) => { Act.act("music.volume", v); } }
    Text { x: root.bx + root.bw + 12px; y: root.row2 - 10px; width: root.colw; height: 20px; text: Math.round(root.volume * 100) + "%"; font-size: 13px; color: root.soft; vertical-alignment: center; }
}

component Controls inherits HorizontalLayout {
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <bool> live;
    in property <color> accent;
    in property <color> ink: #ffffff;
    in property <color> play-bg;
    in property <length> play: 72px;
    alignment: center;
    spacing: 16px;
    VerticalLayout { alignment: center; Ctl { icon: "\u{F049F}"; size: 40px; icon-size: 22px; toggle: true; on: root.shuffle; accent: root.accent; ink: root.ink; opacity: root.live ? 0 : 1; act: root.live ? "" : "music.shuffle"; } }
    VerticalLayout { alignment: center; Ctl { icon: "\u{F04AE}"; size: 48px; icon-size: 34px; ink: root.ink; act: "music.prev"; } }
    VerticalLayout { alignment: center;
        Rectangle {
            width: root.play; height: root.play; border-radius: root.play / 2; background: root.play-bg;
            opacity: play-touch.pressed ? 0.75 : 1;
            Icon { width: parent.width; height: parent.height; text: root.playing ? "\u{F03E4}" : "\u{F040A}"; font-size: root.play * 0.55; color: #ffffff; }
            play-touch := TouchArea { clicked => { Act.act("music.play", ""); } }
        }
    }
    VerticalLayout { alignment: center; Ctl { icon: "\u{F04AD}"; size: 48px; icon-size: 34px; ink: root.ink; act: "music.next"; } }
    VerticalLayout { alignment: center; Ctl { icon: root.repeat == 2 ? "\u{F0458}" : "\u{F0456}"; size: 40px; icon-size: 22px; toggle: true; on: root.repeat > 0; accent: root.accent; ink: root.ink; opacity: root.live ? 0 : 1; act: root.live ? "" : "music.repeat"; } }
}

export component MusicPage inherits Rectangle {
    in property <int> style;               // 0 plain, 1 full cover, 2 turntable, 3 cassette, 4 half cassette
    // turning parts: time since a base set every minute (the speeds make whole turns per minute, so the
    // new base is not seen; a small number stays exact however long the panel runs)
    // The platter's angle in degrees: it spins up to 33 1/3 rpm in 1.2 s (ease-in), coasts down in 2 s
    // (ease-out) and stays where it stopped (no snap back). Counted from the last start or stop; while it
    // plays the count moves on by whole minutes (33 whole turns), so the number stays small and exact.
    property <float> spin-a0;
    property <duration> spin-t0;
    property <bool> spin-on;
    property <bool> coasting;
    init => { root.spin-on = root.playing; }
    pure function spin-at(dt: float) -> float {
        root.spin-on
            ? root.spin-a0 + 198 * (dt < 1.2 ? dt * dt * dt / 4.32 : 0.4 + dt - 1.2)
            : root.spin-a0 + 198 * (dt < 2 ? (1 - (1 - dt / 2) * (1 - dt / 2) * (1 - dt / 2)) * 2 / 3 : 2 / 3)
    }
    // the clock is read only while the platter turns
    property <float> spin-deg: root.spin-on || root.coasting ? root.spin-at((animation-tick() - root.spin-t0) / 1s) : root.spin-a0 + 132;
    changed playing => {
        root.spin-a0 = Math.mod(root.spin-deg, 360);
        root.spin-t0 = animation-tick();
        root.coasting = !root.playing;
        root.spin-on = root.playing;
    }
    Timer { interval: 2100ms; running: root.coasting; triggered => { root.coasting = false; } }
    Timer { interval: 60s; running: root.spin-on; triggered => { if (animation-tick() - root.spin-t0) > 3s { root.spin-t0 = root.spin-t0 + 60s; } } }
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> playing;
    in property <float> pos;               // seconds
    in property <float> dur;               // seconds; 0 = live stream (no progress)
    in property <bool> shuffle;
    in property <int> repeat;              // 0 off, 1 all, 2 one
    in property <float> volume: 0.5;       // 0..1
    in property <string> player;           // name of the active player (+ "+2" when grouped)
    in property <image> art;
    in property <image> art-bg;
    in property <bool> has-art: true;
    in property <string> kind-icon: "\u{F0387}";   // shown instead of the cover (radio, story …)
    in property <color> accent: #e8262d;
    in property <[MusicPlayer]> players;
    in property <bool> picker;
    in property <int> tape-scope;          // cassette: the tape shows 0 this track, 1 the whole queue
    in property <float> q-played;          // seconds of the queue before the current track
    in property <float> q-total;           // seconds of the whole queue
    in property <int> q-index;             // current track in the queue (0-based)
    in property <int> q-count;
    in property <image> tt-deck;
    in property <image> tt-grooves;
    in property <image> cs-back;
    in property <image> cs-front;
    in property <image> cs-hub;
    in property <image> cs-hub-r;          // right hub frame (both reels turn at their own speed); empty = cs-hub
    in property <float> tt-arm-r: -1;      // turntable: stylus radius set by the app (track change: lift, return); -1 = from the position
    in property <float> tt-lift: -1;       // 0 down … 1 lifted; -1 = by play / pause
    in property <float> tape-rem: -1;
    in property <bool> scroll;             // long titles scroll instead of being cut off …
    in property <float> scroll-speed: 3;   // … at this speed (1 slow .. 5 fast)
    in property <bool> settings;           // the music page settings sheet
    in property <int> holds;               // turntable / cassette: the record / tape holds 0 one track, 1 the whole queue
    in property <int> wood;                // turntable: the counter under it (index into woods)
    in property <[image]> woods;           // swatches of the wood choices      // cassette: tape left on the supply reel set by the app (rewind); -1 = from the position
    property <bool> light: root.style == 1 && !Theme.dark;
    property <color> acc: root.light ? root.accent.darker(0.35) : root.accent;
    property <color> ink: root.light ? #18181b : #ffffff;
    property <color> soft: root.ink.with-alpha(root.light ? 0.7 : 0.62);
    property <bool> live: root.dur <= 0;
    property <float> fr: root.live ? 0 : max(0, min(1, root.pos / root.dur));
    background: #101014;

    // ---------- 0 plain ----------
    if root.style == 0: Rectangle {
        Image { width: root.width; height: root.height; source: root.art-bg; image-fit: cover; }
        Rectangle { background: @linear-gradient(180deg, #00000033 0%, #00000000 35%, #00000000 60%, #00000059 100%); }
        Rectangle { x: (root.width - 196px) / 2 + 2px; y: 59px; width: 196px; height: 196px; border-radius: 3px; background: #0000004d; }
        Rectangle {
            x: (root.width - 196px) / 2; y: 52px; width: 196px; height: 196px;
            background: @linear-gradient(135deg, root.acc.mix(#000000, 0.55) 0%, root.acc.mix(#000000, 0.25) 100%);
            if root.has-art: Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover; }
            if !root.has-art: Icon { text: root.kind-icon; font-size: 84px; color: #ffffffd9; }
        }
        Marquee { x: 30px; y: 262px; width: root.width - 60px; height: 30px; text: root.title; font-size: 22px; font-weight: 600; color: #ffffff;
            horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: 30px; y: 293px; width: root.width - 60px; height: 22px; text: root.artist + (root.album != "" ? "  ·  " + root.album : "");
            font-size: 15px; color: #ffffffb3; horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        BarRows { pos: root.pos; dur: root.dur; volume: root.volume; row1: 338px; row2: 443px;
            fill: root.acc; vol-fill: #ffffffcc; track: #ffffff33; knob: #ffffff; ink: #ffffff; soft: #ffffff9e; }
        Controls { y: 358px; width: root.width; height: 72px; playing: root.playing; shuffle: root.shuffle; repeat: root.repeat; live: root.live;
            accent: root.acc.mix(#ffffff, 0.8); play-bg: root.acc; }
    }

    // ---------- 1 full-screen cover ----------
    if root.style == 1: Rectangle {
        background: root.acc.mix(#000000, 0.4);
        if root.has-art: Image { width: root.width; height: root.height; source: root.art; image-fit: cover; }
        if !root.has-art: Icon { y: 96px; height: 160px; text: root.kind-icon; font-size: 112px; color: #ffffffb3; }
        property <color> veil: root.light ? #ffffff : #000000;
        // one stop per rectangle: the software renderer leaves a 1 px seam at an inner gradient stop
        Rectangle { y: 0; height: 42px; background: @linear-gradient(180deg, parent.veil.with-alpha(root.light ? 0.9 : 0.74) 0%, parent.veil.with-alpha(root.light ? 0.86 : 0.68) 100%); }
        Rectangle { y: 42px; height: 108px; background: @linear-gradient(180deg, parent.veil.with-alpha(root.light ? 0.86 : 0.68) 0%, parent.veil.with-alpha(0) 100%); }
        Rectangle { y: 232px; height: 74px; background: @linear-gradient(180deg, parent.veil.with-alpha(0) 0%, parent.veil.with-alpha(root.light ? 0.9 : 0.82) 100%); }
        Rectangle { y: 306px; height: root.height - 306px; background: @linear-gradient(180deg, parent.veil.with-alpha(root.light ? 0.9 : 0.84) 0%, parent.veil.with-alpha(root.light ? 0.96 : 0.94) 100%); }
        Marquee { x: 30px; y: 282px; width: root.width - 60px; height: 30px; text: root.title; font-size: 22px; font-weight: 600; color: root.ink; k: root.light ? 0 : 1;
            horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: 30px; y: 312px; width: root.width - 60px; height: 22px; text: root.artist + (root.album != "" ? "  ·  " + root.album : "");
            font-size: 15px; color: root.soft; k: root.light ? 0 : 1; horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        BarRows { pos: root.pos; dur: root.dur; volume: root.volume; row1: 350px; row2: 443px;
            fill: root.acc; vol-fill: root.ink.with-alpha(0.8); track: root.ink.with-alpha(root.light ? 0.16 : 0.25); knob: root.ink; ink: root.ink; soft: root.soft; }
        Controls { y: 366px; width: root.width; height: 64px; play: 64px; playing: root.playing; shuffle: root.shuffle; repeat: root.repeat; live: root.live;
            accent: root.light ? root.acc : root.acc.mix(#ffffff, 0.8); ink: root.ink; play-bg: root.acc; }
    }

    // ---------- 2 turntable ----------
    if root.style == 2: tt := Rectangle {
        property <float> cx: 172;
        property <float> cy: 254;
        property <float> rv: 134;
        property <float> rl: 54;
        property <float> px: 394;
        property <float> py: 138;
        property <float> la: 238;          // pivot to stylus
        property <float> r-out: 128;
        property <float> r-in: 66;
        property <float> r: root.tt-arm-r >= 0 ? root.tt-arm-r : self.r-out - root.fr * (self.r-out - self.r-in);
        property <float> d: Math.sqrt((self.cx - self.px) * (self.cx - self.px) + (self.cy - self.py) * (self.cy - self.py));
        property <angle> th-c: Math.atan2(self.cy - self.py, self.cx - self.px);
        pure function th-of(r: float) -> angle { self.th-c - Math.acos((self.la * self.la + self.d * self.d - r * r) / (2 * self.la * self.d)) }
        property <angle> th-groove: self.th-of(self.r);
        property <angle> rest: 94deg;
        // paused or stopped: the arm lifts, swings to its rest and sets down there (0.2 + 0.75 s); playing: back
        // onto the groove of the position
        property <float> park: root.playing ? 0 : 1;
        animate park { duration: 750ms; delay: 200ms; easing: ease-in-out; }
        // dragging: the arm follows the finger around the pivot, between the rest and the run-out groove
        property <bool> drag;
        property <angle> th-drag: 94deg;
        // the groove follows the position; a jump (another track) glides over in 0.6 s with the arm lifted
        property <angle> th-glide: self.th-groove;
        animate th-glide { duration: 600ms; easing: ease-in-out; }
        property <bool> gliding: Math.abs((self.th-glide - self.th-groove) / 1deg) > 1.5;
        property <angle> th: self.drag ? self.th-drag : self.th-glide + (self.rest - self.th-glide) * self.park;
        // where the stylus is while dragging: over the rest, or this far into the record (0 lead-in … 1 run-out)
        property <bool> drag-rest: self.th-drag < self.th-of(self.r-out) - 3deg;
        property <float> drag-r: Math.sqrt((self.px + self.la * Math.cos(self.th-drag) - self.cx) * (self.px + self.la * Math.cos(self.th-drag) - self.cx)
            + (self.py + self.la * Math.sin(self.th-drag) - self.cy) * (self.py + self.la * Math.sin(self.th-drag) - self.cy));
        property <float> drag-f: Math.max(0, Math.min(1, (self.r-out - self.drag-r) / (self.r-out - self.r-in)));
        property <float> ux: Math.cos(self.th);
        property <float> uy: Math.sin(self.th);
        property <float> sx: self.px + self.la * self.ux;
        property <float> sy: self.py + self.la * self.uy;
        property <angle> th-h: self.th + 16deg;      // headshell offset
        property <float> hx: Math.cos(self.th-h);
        property <float> hy: Math.sin(self.th-h);
        // lifted while it swings or is dragged; down on the record or on its rest
        property <float> lift: self.drag || self.gliding ? 1 : root.tt-lift >= 0 ? root.tt-lift : Math.min(1, self.park * (1 - self.park) * 12);
        property <float> so-x: 5 + 6 * self.lift;
        property <float> so-y: 7 + 7 * self.lift;
        property <color> amber: #ffb54c;
        property <float> f0: 176;
        property <float> f1: 372;
        Image { width: root.width; height: root.height; source: root.tt-deck; }
        // display window
        Marquee { x: 32px; y: 60px; width: 340px; height: 24px; text: root.title; font-size: 18px; font-weight: 600; color: tt.amber; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: 32px; y: 82px; width: 340px; height: 18px; text: root.artist + (root.album != "" ? "  ·  " + root.album : ""); font-size: 13px; color: tt.amber.with-alpha(0.7);
            scroll: root.scroll; speed: root.scroll-speed; }
        Text { x: 380px; y: 60px; width: 68px; height: 24px; text: root.live ? "LIVE" : self.mmss(root.pos); font-size: 18px; font-weight: 600; color: tt.amber; horizontal-alignment: right; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        if !root.live: Text { x: 372px; y: 82px; width: 76px; height: 18px; text: "−" + self.mmss(max(0, root.dur - root.pos)); font-size: 13px; color: tt.amber.with-alpha(0.7); horizontal-alignment: right; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        // the record: square cover under a thick round border = round label
        Rectangle {
            x: (tt.cx - 70) * 1px; y: (tt.cy - 70) * 1px; width: 140px; height: 140px;   // ~1.3 × the label: its middle shows
            background: root.acc.mix(#000000, 0.5);
            if root.has-art: Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover;
                rotation-angle: root.spin-deg * 1deg;      // 33 rpm, spinning up and coasting down
                rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
            if !root.has-art: Icon { text: root.kind-icon; font-size: 52px; color: #ffffffcc; }
        }
        Rectangle {
            x: (tt.cx - tt.rv) * 1px; y: (tt.cy - tt.rv) * 1px; width: 2 * tt.rv * 1px; height: self.width;
            border-radius: tt.rv * 1px; border-width: (tt.rv - tt.rl) * 1px; border-color: root.acc.mix(#000000, 0.82);
        }
        Image { x: (tt.cx - tt.rv) * 1px; y: (tt.cy - tt.rv) * 1px; width: 2 * tt.rv * 1px; height: self.width; source: root.tt-grooves; }
        // tone arm: shadow, counterweight, tube, headshell, pivot cap. Stroked Paths sit in a box one stroke
        // larger (Slint fits the stroke inside the box), so the lines land exactly where computed; the
        // counterweight (12..31 px behind the pivot) stays clear of the display window in every arm position
        Path { x: -(9px) / 2; y: -(9px) / 2; width: 480px + 9px; height: 480px + 9px; viewbox-width: 480; viewbox-height: 480; stroke: #00000040; stroke-width: 9px;
            MoveTo { x: tt.px + tt.so-x; y: tt.py + tt.so-y; }
            LineTo { x: tt.sx - 24 * tt.hx + tt.so-x; y: tt.sy - 24 * tt.hy + tt.so-y; } }
        Path { width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: #00000040;
            MoveTo { x: tt.sx + 6 * tt.hx - 8 * tt.hy + tt.so-x; y: tt.sy + 6 * tt.hy + 8 * tt.hx + tt.so-y; }
            LineTo { x: tt.sx + 6 * tt.hx + 8 * tt.hy + tt.so-x; y: tt.sy + 6 * tt.hy - 8 * tt.hx + tt.so-y; }
            LineTo { x: tt.sx - 26 * tt.hx + 8 * tt.hy + tt.so-x; y: tt.sy - 26 * tt.hy - 8 * tt.hx + tt.so-y; }
            LineTo { x: tt.sx - 26 * tt.hx - 8 * tt.hy + tt.so-x; y: tt.sy - 26 * tt.hy + 8 * tt.hx + tt.so-y; }
            Close {} }
        Path { x: -(26px) / 2; y: -(26px) / 2; width: 480px + 26px; height: 480px + 26px; viewbox-width: 480; viewbox-height: 480; stroke: #3c3f46; stroke-width: 26px;
            MoveTo { x: tt.px - 12 * tt.ux; y: tt.py - 12 * tt.uy; }
            LineTo { x: tt.px - 31 * tt.ux; y: tt.py - 31 * tt.uy; } }
        Path { x: -(20px) / 2; y: -(20px) / 2; width: 480px + 20px; height: 480px + 20px; viewbox-width: 480; viewbox-height: 480; stroke: #8d929c; stroke-width: 20px;
            MoveTo { x: tt.px - 14 * tt.ux; y: tt.py - 14 * tt.uy; }
            LineTo { x: tt.px - 29 * tt.ux; y: tt.py - 29 * tt.uy; } }
        Path { x: -(8px) / 2; y: -(8px) / 2; width: 480px + 8px; height: 480px + 8px; viewbox-width: 480; viewbox-height: 480; stroke: #5d616a; stroke-width: 8px;
            MoveTo { x: tt.px; y: tt.py; }
            LineTo { x: tt.sx - 24 * tt.hx; y: tt.sy - 24 * tt.hy; } }
        Path { x: -(5px) / 2; y: -(5px) / 2; width: 480px + 5px; height: 480px + 5px; viewbox-width: 480; viewbox-height: 480; stroke: #dfe2e7; stroke-width: 5px;
            MoveTo { x: tt.px; y: tt.py; }
            LineTo { x: tt.sx - 24 * tt.hx; y: tt.sy - 24 * tt.hy; } }
        Path { x: -(1.4px) / 2; y: -(1.4px) / 2; width: 480px + 1.4px; height: 480px + 1.4px; viewbox-width: 480; viewbox-height: 480; stroke: #ffffffb0; stroke-width: 1.4px;
            MoveTo { x: tt.px - 1.2 * tt.uy; y: tt.py + 1.2 * tt.ux; }
            LineTo { x: tt.sx - 24 * tt.hx - 1.2 * tt.uy; y: tt.sy - 24 * tt.hy + 1.2 * tt.ux; } }
        // headshell (dark) with the cartridge (accent) and a finger lift
        Path { x: -(1px) / 2; y: -(1px) / 2; width: 480px + 1px; height: 480px + 1px; viewbox-width: 480; viewbox-height: 480; fill: #26272b; stroke: #6a6e77; stroke-width: 1px;
            MoveTo { x: tt.sx + 6 * tt.hx - 8 * tt.hy; y: tt.sy + 6 * tt.hy + 8 * tt.hx; }
            LineTo { x: tt.sx + 6 * tt.hx + 8 * tt.hy; y: tt.sy + 6 * tt.hy - 8 * tt.hx; }
            LineTo { x: tt.sx - 26 * tt.hx + 7 * tt.hy; y: tt.sy - 26 * tt.hy - 7 * tt.hx; }
            LineTo { x: tt.sx - 26 * tt.hx - 7 * tt.hy; y: tt.sy - 26 * tt.hy + 7 * tt.hx; }
            Close {} }
        Path { width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: root.acc;
            MoveTo { x: tt.sx + 3 * tt.hx - 5 * tt.hy; y: tt.sy + 3 * tt.hy + 5 * tt.hx; }
            LineTo { x: tt.sx + 3 * tt.hx + 5 * tt.hy; y: tt.sy + 3 * tt.hy - 5 * tt.hx; }
            LineTo { x: tt.sx - 13 * tt.hx + 5 * tt.hy; y: tt.sy - 13 * tt.hy - 5 * tt.hx; }
            LineTo { x: tt.sx - 13 * tt.hx - 5 * tt.hy; y: tt.sy - 13 * tt.hy + 5 * tt.hx; }
            Close {} }
        Path { x: -(3px) / 2; y: -(3px) / 2; width: 480px + 3px; height: 480px + 3px; viewbox-width: 480; viewbox-height: 480; stroke: #c9ccd2; stroke-width: 3px;
            MoveTo { x: tt.sx - 6 * tt.hx - 8 * tt.hy; y: tt.sy - 6 * tt.hy + 8 * tt.hx; }
            LineTo { x: tt.sx - 6 * tt.hx - 17 * tt.hy; y: tt.sy - 6 * tt.hy + 17 * tt.hx; } }
        Rectangle { x: (tt.px - 11) * 1px; y: (tt.py - 11) * 1px; width: 22px; height: 22px; border-radius: 11px; background: #e4e6ea; border-width: 1px; border-color: #7a7e86; }
        Rectangle { x: (tt.px - 4) * 1px; y: (tt.py - 4) * 1px; width: 8px; height: 8px; border-radius: 4px; background: #44474e; }
        // drag the arm to seek: a press on the arm or the headshell lifts it, it follows the finger, a
        // bubble shows the time; let go on the record = seek there (and play), on the rest = pause
        TouchArea {
            x: 20px; y: 110px; width: 400px; height: 300px;
            pure function dist-to-arm(mx: float, my: float) -> float {
                Math.min(Math.sqrt((mx - tt.sx) * (mx - tt.sx) + (my - tt.sy) * (my - tt.sy)),
                    Math.abs((my - tt.py) * tt.ux - (mx - tt.px) * tt.uy))
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && self.dist-to-arm(self.x / 1px + self.mouse-x / 1px, self.y / 1px + self.mouse-y / 1px) < 26 {
                    tt.th-drag = tt.th;
                    tt.drag = true;
                    Act.hold-swipe = true;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && tt.drag {
                    tt.drag = false;
                    Act.hold-swipe = false;
                    // a cancelled touch only lets the arm go back
                    if e.kind == PointerEventKind.up && tt.drag-rest {
                        Act.act("music.pause", "");
                    } else if e.kind == PointerEventKind.up && !root.live {
                        Act.act("music.seek", tt.drag-f * root.dur);
                        if !root.playing { Act.act("music.resume", ""); }
                    }
                }
            }
            moved => {
                if tt.drag {
                    tt.th-drag = Math.max(tt.rest, Math.min(tt.th-of(tt.r-in), Math.atan2(self.y / 1px + self.mouse-y / 1px - tt.py, self.x / 1px + self.mouse-x / 1px - tt.px)));
                }
            }
        }
        if tt.drag && !root.live: Rectangle {
            x: (tt.sx - 34) * 1px; y: (tt.sy - 52) * 1px; width: 68px; height: 28px; border-radius: 14px; background: #000000cc;
            Text { text: tt.drag-rest ? "Pause" : Math.floor(tt.drag-f * root.dur / 60) + ":" + (Math.mod(Math.floor(tt.drag-f * root.dur), 60) < 10 ? "0" : "") + Math.mod(Math.floor(tt.drag-f * root.dur), 60);
                font-size: 15px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
        // volume fader (dark print on aluminium)
        // speaker over the value, both centred on the fader (100 % fits inside the plate)
        // the fader follows the finger; the volume is set when it lets go
        property <bool> fdrag;
        property <float> fv;
        property <float> vol: self.fdrag ? self.fv : root.volume;
        Icon { x: 426px; y: 122px; width: 40px; height: 18px; text: tt.vol <= 0 ? "\u{F0581}" : "\u{F057E}"; font-size: 16px; color: #3a3c42; }
        Text { x: 418px; y: 142px; width: 56px; height: 18px; text: Math.round(tt.vol * 100) + "%"; font-size: 13px; font-weight: 600; color: #3a3c42;
            horizontal-alignment: center; vertical-alignment: center; }
        Rectangle {
            x: 431px; y: (tt.f1 - tt.vol * (tt.f1 - tt.f0) - 9) * 1px; width: 30px; height: 18px; border-radius: 3px;
            background: #d6d8dc; border-width: 1px; border-color: #6d7078;
            Rectangle { y: 8px; height: 2px; x: 4px; width: parent.width - 8px; background: root.acc; }
        }
        TouchArea {
            x: 418px; y: (tt.f0 - 16) * 1px; width: 56px; height: (tt.f1 - tt.f0 + 32) * 1px;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    tt.fdrag = true;
                    tt.fv = max(0, min(1, (tt.f1 - (self.y + self.mouse-y) / 1px) / (tt.f1 - tt.f0)));
                }
                if ev.kind == PointerEventKind.up {
                    if tt.fdrag { Act.act("music.volume", tt.fv); }
                    tt.fdrag = false;
                }
                if ev.kind == PointerEventKind.cancel { tt.fdrag = false; }
            }
            moved => { tt.fv = max(0, min(1, (tt.f1 - (self.y + self.mouse-y) / 1px) / (tt.f1 - tt.f0))); }
        }
        // start / stop and the small buttons
        Rectangle {
            x: 21px; y: 405px; width: 82px; height: 36px; border-radius: 6px;
            background: tt-play.pressed ? #b02a20 : #cf3428;
            Rectangle { x: 6px; y: 3px; width: parent.width - 12px; height: 2px; border-radius: 1px; background: #ffffff4d; }
            Icon { text: root.playing ? "\u{F03E4}" : "\u{F040A}"; font-size: 24px; color: #ffffff; }
            tt-play := TouchArea { clicked => { Act.act("music.play", ""); } }
        }
        for b[i] in [
            { icon: "\u{F049F}", on: root.shuffle, toggle: true, act: "music.shuffle" },
            { icon: "\u{F04AE}", on: false, toggle: false, act: "music.prev" },
            { icon: "\u{F04AD}", on: false, toggle: false, act: "music.next" },
            { icon: root.repeat == 2 ? "\u{F0458}" : "\u{F0456}", on: root.repeat > 0, toggle: true, act: "music.repeat" },
        ]: Rectangle {
            x: (297 + i * 42) * 1px; y: 407px; width: 34px; height: 32px; border-radius: 5px;
            background: tt-key.pressed ? #b9bcc2 : #d3d6db;
            tt-key := TouchArea { clicked => { if !(b.toggle && root.live) { Act.act(b.act, ""); } } }
            Rectangle { x: 4px; y: parent.height - 4px; width: parent.width - 8px; height: 2px; border-radius: 1px; background: #00000026; }
            opacity: b.toggle && root.live ? 0.35 : 1;
            Icon { text: b.icon; font-size: 20px; color: #2c2e33; }
            if b.toggle: Rectangle { x: (parent.width - 6px) / 2; y: -9px; width: 6px; height: 4px; border-radius: 2px; background: b.on ? root.acc : #00000040; }
        }
    }

    // ---------- 3 cassette, 4 half cassette ----------
    if root.style == 3 || root.style == 4: cs := Rectangle {
        property <bool> half: root.style == 4;
        property <float> k: self.half ? 6.2 : 4.4;            // px per mm
        property <float> ox: self.half ? 16 : 19;              // cassette body origin
        property <float> oy: 52;
        property <float> hub-r: 10.6;
        property <float> pack-max: 23;
        property <float> hub-y: 30.5;
        property <float> sx0: 50.2 - 21.25;                    // supply reel (left)
        property <float> tx0: 50.2 + 21.25;                    // take-up reel (right)
        property <float> rem: root.tape-rem >= 0 ? root.tape-rem : root.tape-scope == 1 && root.q-total > 0
            ? max(0, min(1, 1 - (root.q-played + root.pos) / root.q-total)) : 1 - root.fr;
        property <float> rs: Math.sqrt(self.hub-r * self.hub-r + self.rem * (self.pack-max * self.pack-max - self.hub-r * self.hub-r));
        property <float> rt: Math.sqrt(self.hub-r * self.hub-r + (1 - self.rem) * (self.pack-max * self.pack-max - self.hub-r * self.hub-r));
        // tape: supply pack (outer side) → round the left corner roller → along the front → round the
        // right roller → take-up pack (outer side). External tangents: n·(P − C) = rr − R.
        property <float> rr: 2.3;                               // tape centre line round the roller (r 2.1)
        property <float> ry: 58.2;                              // roller centres (y), x 8.6 / 91.8
        property <float> d1x: 8.6 - self.sx0;
        property <float> d1y: self.ry - self.hub-y;
        property <float> d1: Math.sqrt(self.d1x * self.d1x + self.d1y * self.d1y);
        property <angle> f1: Math.atan2(self.d1y, self.d1x) - Math.acos((self.rr - self.rs) / self.d1);
        property <float> d2x: 91.8 - self.tx0;
        property <float> d2: Math.sqrt(self.d2x * self.d2x + self.d1y * self.d1y);
        property <angle> f2: Math.atan2(self.d1y, self.d2x) + Math.acos((self.rr - self.rt) / self.d2);
        pure function px(mm: float) -> float { self.ox + mm * self.k }
        pure function py(mm: float) -> float { self.oy + mm * self.k }
        property <string> tape: "M " + self.px(self.sx0 - self.rs * Math.cos(self.f1)) + " " + self.py(self.hub-y - self.rs * Math.sin(self.f1))
            + " L " + self.px(8.6 - self.rr * Math.cos(self.f1)) + " " + self.py(self.ry - self.rr * Math.sin(self.f1))
            + " A " + (self.rr * self.k) + " " + (self.rr * self.k) + " 0 0 0 " + self.px(8.6) + " " + self.py(self.ry + self.rr)
            + " L " + self.px(91.8) + " " + self.py(self.ry + self.rr)
            + " A " + (self.rr * self.k) + " " + (self.rr * self.k) + " 0 0 0 " + self.px(91.8 - self.rr * Math.cos(self.f2)) + " " + self.py(self.ry - self.rr * Math.sin(self.f2))
            + " L " + self.px(self.tx0 - self.rt * Math.cos(self.f2)) + " " + self.py(self.hub-y - self.rt * Math.sin(self.f2));
        property <length> label-r: self.half ? 336px : root.width;   // visible right edge of the label
        Image { width: root.width; height: root.height; source: root.art-bg; image-fit: cover; }
        Rectangle { background: #00000059; }
        Image { x: (cs.ox - 14) * 1px; y: (cs.oy - 14) * 1px; source: root.cs-back; }
        // tape packs
        Rectangle {
            x: (cs.ox + (cs.sx0 - cs.rs) * cs.k) * 1px; y: (cs.oy + (cs.hub-y - cs.rs) * cs.k) * 1px;
            width: 2 * cs.rs * cs.k * 1px; height: self.width; border-radius: self.width / 2;
            background: #563d2e; border-width: 1px; border-color: #8a6a52;
            Rectangle { x: parent.width * 0.16; y: self.x; width: parent.width * 0.68; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff14; }
        }
        Rectangle {
            x: (cs.ox + (cs.tx0 - cs.rt) * cs.k) * 1px; y: (cs.oy + (cs.hub-y - cs.rt) * cs.k) * 1px;
            width: 2 * cs.rt * cs.k * 1px; height: self.width; border-radius: self.width / 2;
            background: #563d2e; border-width: 1px; border-color: #8a6a52;
            Rectangle { x: parent.width * 0.16; y: self.x; width: parent.width * 0.68; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff14; }
        }
        Path { x: -((0.7 * cs.k) * 1px) / 2; y: -((0.7 * cs.k) * 1px) / 2; width: 480px + (0.7 * cs.k) * 1px; height: 480px + (0.7 * cs.k) * 1px; viewbox-width: 480; viewbox-height: 480; stroke: #4b3427; stroke-width: (0.7 * cs.k) * 1px; commands: cs.tape; }
        // hubs (on the panel: a sprite frame per rotation step)
        Image { x: (cs.ox + cs.sx0 * cs.k) * 1px - self.width / 2; y: (cs.oy + cs.hub-y * cs.k) * 1px - self.height / 2; source: root.cs-hub;
            rotation-angle: -root.spin-deg * 90 / 198 * 1deg; rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
        Image { x: (cs.ox + cs.tx0 * cs.k) * 1px - self.width / 2; y: (cs.oy + cs.hub-y * cs.k) * 1px - self.height / 2; source: root.cs-hub-r.width > 0 ? root.cs-hub-r : root.cs-hub;
            rotation-angle: -root.spin-deg * 120 / 198 * 1deg; rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
        Image { x: (cs.ox - 14) * 1px; y: (cs.oy - 14) * 1px; source: root.cs-front; }
        // label: side letter, title, artist, stripes in the accent
        Rectangle {
            x: (cs.ox + 6.6 * cs.k) * 1px; y: (cs.oy + 5.4 * cs.k) * 1px; width: 7.6 * cs.k * 1px; height: self.width; border-radius: self.width / 2;
            background: root.acc;
            Text { text: "A"; font-size: 5.2 * cs.k * 1px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
        Marquee { x: (cs.ox + 17.4 * cs.k) * 1px; y: (cs.oy + 5.0 * cs.k) * 1px; width: cs.label-r - self.x - (cs.half ? 12px : (100.4 - 93) * cs.k * 1px + cs.ox * 1px);
            height: 5.8 * cs.k * 1px; text: root.title; font-size: cs.half ? 24px : 4.5 * cs.k * 1px; font-weight: 700; color: #26221d; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: (cs.ox + 17.6 * cs.k) * 1px; y: (cs.oy + 11.0 * cs.k) * 1px;
            width: cs.label-r - self.x - (cs.half ? 12px : (100.4 - 93) * cs.k * 1px + cs.ox * 1px) - (cs.half ? 0px : 96px);
            height: 4.6 * cs.k * 1px; text: root.artist; font-size: cs.half ? 17px : 3.2 * cs.k * 1px; color: #4d453c; scroll: root.scroll; speed: root.scroll-speed; }
        if !cs.half && root.q-count > 0: Text { x: (cs.ox + 92.6 * cs.k) * 1px - 92px; y: (cs.oy + 11.0 * cs.k) * 1px; width: 92px; height: 4.6 * cs.k * 1px;
            text: (root.q-index + 1) + " / " + root.q-count; font-size: 3.0 * cs.k * 1px; color: #6d6458; horizontal-alignment: right; vertical-alignment: bottom; }
        Rectangle { x: (cs.ox + 4.6 * cs.k) * 1px; y: (cs.oy + 17.4 * cs.k) * 1px; width: min(cs.label-r - self.x, 91.2 * cs.k * 1px); height: 2.3 * cs.k * 1px; background: root.acc; }
        Rectangle { x: (cs.ox + 4.6 * cs.k) * 1px; y: (cs.oy + 20.1 * cs.k) * 1px; width: min(cs.label-r - self.x, 91.2 * cs.k * 1px); height: 0.8 * cs.k * 1px; background: root.acc.darker(0.3); }
        Rectangle { x: (cs.ox + 4.6 * cs.k) * 1px; y: (cs.oy + 21.5 * cs.k) * 1px; width: min(cs.label-r - self.x, 91.2 * cs.k * 1px); height: 0.8 * cs.k * 1px; background: root.acc.brighter(0.35); }

        // full cassette: times + controls + volume below
        if !cs.half: BarRows { pos: root.pos; dur: 0; volume: root.volume; row1: -100px; row2: 443px;
            fill: root.acc; vol-fill: #ffffffcc; track: #ffffff33; knob: #ffffff; ink: #ffffff; soft: #ffffff9e; }
        if !cs.half && !root.live: Text { x: 20px; y: 376px; width: 64px; height: 20px; text: self.mmss(root.pos); font-size: 13px; color: #ffffff9e; horizontal-alignment: right; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        if !cs.half && !root.live: Text { x: 396px; y: 376px; width: 64px; height: 20px; text: "−" + self.mmss(max(0, root.dur - root.pos)); font-size: 13px; color: #ffffff9e; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        if !cs.half: Controls { y: 354px; width: root.width; height: 64px; play: 64px; spacing: 12px; playing: root.playing; shuffle: root.shuffle; repeat: root.repeat; live: root.live;
            accent: root.acc.mix(#ffffff, 0.8); play-bg: root.acc; }

        // half cassette: the right half slides under the control panel
        if cs.half: Rectangle {
            x: 314px; width: 24px; background: @linear-gradient(90deg, #00000000 0%, #00000080 100%);
        }
        if cs.half: Rectangle {
            x: 336px; width: root.width - 336px;
            background: @linear-gradient(180deg, #1d1d22 0%, #141418 100%);
            Rectangle { x: 0; width: 1px; background: #ffffff1f; }
                        if !root.live: Text { x: 0; y: 90px; width: parent.width; height: 32px; text: self.mmss(root.pos); font-size: 26px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center;
                pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
                pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
            }
            if !root.live: Text { x: 0; y: 122px; width: parent.width; height: 20px; text: "−" + self.mmss(max(0, root.dur - root.pos)); font-size: 14px; color: #ffffff9e; horizontal-alignment: center; vertical-alignment: center;
                pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
                pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
            }
            Rectangle {
                x: (parent.width - 72px) / 2; y: 158px; width: 72px; height: 72px; border-radius: 36px; background: root.acc;
                Icon { width: parent.width; height: parent.height; text: root.playing ? "\u{F03E4}" : "\u{F040A}"; font-size: 40px; color: #ffffff; }
            }
            Ctl { x: parent.width / 2 - 56px; y: 246px; size: 48px; icon-size: 34px; icon: "\u{F04AE}"; }
            Ctl { x: parent.width / 2 + 8px; y: 246px; size: 48px; icon-size: 34px; icon: "\u{F04AD}"; }
            Ctl { x: parent.width / 2 - 52px; y: 306px; size: 40px; icon-size: 22px; icon: "\u{F049F}"; toggle: true; on: root.shuffle; accent: root.acc.mix(#ffffff, 0.8); opacity: root.live ? 0 : 1; }
            Ctl { x: parent.width / 2 + 12px; y: 306px; size: 40px; icon-size: 22px; icon: root.repeat == 2 ? "\u{F0458}" : "\u{F0456}"; toggle: true; on: root.repeat > 0; accent: root.acc.mix(#ffffff, 0.8); opacity: root.live ? 0 : 1; }
            Icon { x: 8px; y: 370px; width: 20px; height: 20px; text: root.volume <= 0 ? "\u{F0581}" : root.volume > 0.6 ? "\u{F057E}" : root.volume > 0.25 ? "\u{F0580}" : "\u{F057F}"; font-size: 18px; color: #ffffff9e; }
            Bar { x: 36px; y: 378px; width: parent.width - 36px - 46px; value: root.volume; fill: #ffffffcc; track: #ffffff33; knob: #ffffff; }
            Text { x: parent.width - 38px; y: 370px; width: 34px; height: 20px; text: Math.round(root.volume * 100) + "%"; font-size: 13px; color: #ffffff9e; vertical-alignment: center; }
        }
    }

    // speaker chip (top right): tap = choose which player this page shows
    Rectangle {
        x: root.style == 4 ? 336px + (root.width - 336px - self.width) / 2 : root.width - 16px - self.width; y: 10px; height: 32px;
        width: min(root.style == 4 ? 128px : 200px, sp.preferred-width + 46px);
        border-radius: 16px; background: root.light ? #0000001a : #ffffff1f;
        Icon { x: 12px; y: 0; width: 20px; height: parent.height; text: "\u{F04C3}"; font-size: 18px; color: root.ink.with-alpha(0.9); }
        sp := Text { x: 36px; y: 0; width: parent.width - 46px; height: parent.height; text: root.player; font-size: 14px; font-weight: 600; color: root.ink; vertical-alignment: center; overflow: elide; }
        TouchArea { y: -6px; height: parent.height + 12px; clicked => { Act.act("music.picker", ""); } }
    }

    // settings: look, what the record / tape holds, long titles (cut off or scroll, speed)
    if root.settings: Rectangle { background: #00000080; }
    if root.settings: Rectangle {
        // as tall as its rows need (header 72 px, rows 54 px apart, 24 px under the last); the page shows above it
        property <int> rows: 2 + (root.style >= 2 ? 1 : 0) + (root.style == 2 ? 1 : 0) + (root.scroll ? 1 : 0);
        x: 0; y: root.height - self.height; width: root.width; height: 72px + self.rows * 54px - 22px + 24px;
        border-top-left-radius: 24px; border-top-right-radius: 24px;
        background: #1d1d21f7;
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: #ffffff40; }
        Text { x: 20px; y: 22px; text: "Music"; font-size: 20px; font-weight: 600; color: #ffffff; }
        Rectangle {
            x: parent.width - 16px - 88px - 46px; y: 18px; width: 36px; height: 36px; border-radius: 18px; background: #ffffff1f;
            Icon { text: "\u{F02FD}"; font-size: 21px; color: #ffffffe6; }
        }
        Rectangle {
            x: parent.width - 16px - 88px; y: 19px; width: 88px; height: 34px; border-radius: 17px; background: Theme.text;
            Text { text: "Done"; font-size: 15px; font-weight: 600; color: Theme.background; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle {
            x: 16px; y: 72px; width: parent.width - 16px; height: 32px; clip: true;
            HorizontalLayout {
                alignment: start; spacing: 6px;
                for l[i] in ["Plain", "Full cover", "Turntable", "Cassette", "Half cassette"]: Rectangle {
                    width: lt.preferred-width + 22px; height: 32px; border-radius: 16px;
                    background: i == root.style ? root.acc : transparent; border-width: i == root.style ? 0px : 1px; border-color: #ffffff40;
                    lt := Text { x: 11px; width: self.preferred-width; height: parent.height; text: l; font-size: 13px; font-weight: 500; color: #ffffff; vertical-alignment: center; }
                }
            }
        }
        // rows 54 px apart: look, holds (turntable / cassettes), wood (turntable), long text, speed
        property <length> row-h: 54px;
        property <length> r-text: 72px + (root.style >= 2 ? 1 : 0) * self.row-h + (root.style == 2 ? 1 : 0) * self.row-h + self.row-h;
        if root.style >= 2: HorizontalLayout {
            x: 16px; y: 72px + 54px; height: 32px; alignment: start; spacing: 6px;
            for l[i] in ["One track", "Whole queue"]: Rectangle {
                width: lh.preferred-width + 26px; height: 32px; border-radius: 16px;
                background: i == root.holds ? root.acc : transparent; border-width: i == root.holds ? 0px : 1px; border-color: #ffffff40;
                lh := Text { x: 13px; width: self.preferred-width; height: parent.height; text: l; font-size: 14px; font-weight: 500; color: #ffffff; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            x: 16px; y: parent.r-text; height: 32px; alignment: start; spacing: 6px;
            for l[i] in ["Cut off", "Scroll"]: Rectangle {
                width: ls.preferred-width + 26px; height: 32px; border-radius: 16px;
                background: (i == 1) == root.scroll ? root.acc : transparent; border-width: (i == 1) == root.scroll ? 0px : 1px; border-color: #ffffff40;
                ls := Text { x: 13px; width: self.preferred-width; height: parent.height; text: l; font-size: 14px; font-weight: 500; color: #ffffff; vertical-alignment: center; }
            }
        }
        // turntable: the wood of the counter it stands on (photo swatches)
        if root.style == 2: Rectangle {
            x: 16px; y: 72px + 2 * 54px; width: parent.width - 32px; height: 32px;
            for w[i] in root.woods: Rectangle {
                x: i * 60px; width: 52px; height: 32px;
                Image { width: parent.width; height: parent.height; source: w; image-fit: cover; }
                Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-radius: 4px;
                    border-width: i == root.wood ? 2px : 0px; border-color: #ffffff; }
            }
        }
        // scroll speed: slow .. fast in five steps
        if root.scroll: Rectangle {
            x: 16px; y: parent.r-text + parent.row-h; width: parent.width - 32px; height: 32px;
            Icon { x: 0; width: 28px; height: parent.height; text: "\u{F0D3B}"; font-size: 22px; color: #ffffffb3; }
            Icon { x: parent.width - 28px; width: 28px; height: parent.height; text: "\u{F0907}"; font-size: 22px; color: #ffffffb3; }
            Rectangle {
                x: 44px; y: 14px; width: parent.width - 88px; height: 4px; border-radius: 2px; background: #ffffff33;
                Rectangle { width: parent.width * (root.scroll-speed - 1) / 4; border-radius: 2px; background: root.acc; x: 0; }
                for i in 5: Rectangle { x: parent.width * i / 4 - 2px; y: -3px; width: 4px; height: 10px; border-radius: 2px; background: i <= root.scroll-speed - 1 ? root.acc : #ffffff59; }
                Rectangle { x: parent.width * (root.scroll-speed - 1) / 4 - 9px; y: -7px; width: 18px; height: 18px; border-radius: 9px; background: #ffffff; }
            }
        }
    }

    // player picker: tap a row = show that player here (remembered); ⇄ = move the music there; + = play there too
    if root.picker: Rectangle { background: #00000080; TouchArea { clicked => { Act.act("music.picker-close", ""); } } }
    if root.picker: Rectangle {
        x: 0; y: 88px; width: root.width; height: root.height - 88px;
        TouchArea { }
        border-top-left-radius: 24px; border-top-right-radius: 24px;
        background: #1d1d21f7;
        clip: true;
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: #ffffff40; }
        Text { x: 20px; y: 22px; text: "Play on"; font-size: 20px; font-weight: 600; color: #ffffff; }
        Rectangle {
            x: parent.width - 96px; y: 18px; width: 36px; height: 36px; border-radius: 18px;
            Icon { text: "\u{F02FD}"; font-size: 20px; color: #ffffff99; }
        }
        Rectangle {
            x: parent.width - 52px; y: 18px; width: 36px; height: 36px; border-radius: 18px; background: #ffffff14;
            Icon { text: "\u{F0156}"; font-size: 20px; color: #ffffffcc; }
            TouchArea { clicked => { Act.act("music.picker-close", ""); } }
        }
        for p[i] in root.players: Rectangle {
            x: 12px; y: 64px + i * 52px; width: parent.width - 24px; height: 48px; border-radius: 14px;
            background: p.active ? root.acc.with-alpha(0.18) : transparent;
            TouchArea { clicked => { Act.act("music.show", i); } }
            Icon { x: 10px; y: 0; width: 28px; height: parent.height; text: p.icon; font-size: 22px; color: p.active || p.grouped ? #ffffff : #ffffffb3; }
            Text { x: 48px; y: p.now != "" ? 4px : 0; width: parent.width - 152px; height: p.now != "" ? 22px : parent.height; text: p.name; font-size: 16px; font-weight: p.active ? 600 : 400;
                color: #ffffff; vertical-alignment: center; overflow: elide; }
            if p.now != "": HorizontalLayout {
                x: 48px; y: 25px; width: parent.width - 152px; height: 18px; spacing: 6px;
                if p.playing: Rectangle {
                    width: 12px;
                    for b in 3: Rectangle { x: b * 4px; y: (parent.height - self.height) / 2 + 2px; width: 3px; height: b == 1 ? 11px : b == 0 ? 6px : 9px; border-radius: 1px; background: root.acc.mix(#ffffff, 0.8); }
                }
                Text { text: p.now; font-size: 12px; color: #ffffff99; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            // transfer (not for the shown one)
            if !p.active: Rectangle {
                x: parent.width - 96px; y: (parent.height - 36px) / 2; width: 36px; height: 36px; border-radius: 18px;
                border-width: 1.5px; border-color: #ffffff4d;
                Icon { text: "\u{F04E1}"; font-size: 20px; color: #ffffffd9; }
                TouchArea { clicked => { Act.act("music.transfer", i); } }
            }
            // shown one: check; others: + to play there too, filled check when grouped
            Rectangle {
                x: parent.width - 52px; y: (parent.height - 36px) / 2; width: 36px; height: 36px; border-radius: 18px;
                background: p.active ? root.acc : p.grouped ? #ffffff2e : transparent;
                border-width: p.active || p.grouped ? 0px : 1.5px; border-color: #ffffff4d;
                Icon { text: p.active || p.grouped ? "\u{F012C}" : "\u{F0415}"; font-size: 20px; color: #ffffff; }
                TouchArea { enabled: !p.active; clicked => { Act.act("music.group", i); } }
            }
        }
    }
}
