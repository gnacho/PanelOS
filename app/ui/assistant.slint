// Assistant mode: an Echo Show / Nest Hub-like home screen (clock,
// weather, forecast, media, quick tiles), the full-screen conversation,
// and the layers Home Assistant can open (weather, media, message).

import { Theme } from "theme.slint";
import { Icon, RoundButton, BigSlider, MarkButton } from "widgets.slint";
import { TileData, RowData, RowView } from "rows.slint";

export struct ForecastItem {
    label: string,
    icon: string,
    temp: string,
    low: string,
    precip: string,
}

export struct AssistantData {
    has-weather: bool,
    weather-icon: string,
    temperature: string,
    condition: string,
    details: string,
    hourly: [ForecastItem],
    daily: [ForecastItem],
    has-media: bool,
    media: TileData,
    media-source: string,
    media-album: string,
    hint: string,
    setup-hint: string,
}

component ForecastCell inherits VerticalLayout {
    in property <ForecastItem> item;
    alignment: center;
    spacing: 1px;
    Text { text: root.item.label; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
    Icon { text: root.item.icon; font-size: 28px; color: Theme.text; }
    Text { text: root.item.temp; font-size: 16px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
    // Daily: low temperature; hourly: chance of rain.
    Text {
        text: root.item.low != "" ? root.item.low : root.item.precip;
        font-size: 12px;
        color: root.item.low != "" ? Theme.muted : #38bdf8;
        horizontal-alignment: center;
    }
}

component Artwork inherits Rectangle {
    in property <image> art;
    in property <bool> has-art;
    in property <length> icon-size: 40px;
    border-radius: 12px;
    background: Theme.button;
    clip: true;
    if root.has-art: Image {
        width: parent.width;
        height: parent.height;
        source: root.art;
        image-fit: cover;
    }
    if !root.has-art: Icon { text: "\u{F075A}"; font-size: root.icon-size; color: Theme.muted; }
}

component MediaCard inherits Rectangle {
    in property <AssistantData> data;
    in property <image> art;
    in property <bool> has-art;
    callback act(string);
    callback open();
    height: 104px;
    border-radius: Theme.radius;
    background: Theme.card;
    TouchArea { clicked => { root.open(); } }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Artwork { width: 80px; height: 80px; art: root.art; has-art: root.has-art; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.data.media.title != "" ? root.data.media.title : root.data.media.name;
                font-size: 17px;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
            }
            Text { text: root.data.media.artist; font-size: 14px; color: Theme.muted; overflow: elide; }
            Text { text: root.data.media-source; font-size: 12px; color: Theme.faint; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            RoundButton {
                icon: root.data.media.playing ? "\u{F03E4}" : "\u{F040A}";
                size: 52px;
                clicked => { root.act("play_pause"); }
            }
        }
        VerticalLayout {
            alignment: center;
            RoundButton { icon: "\u{F04AD}"; size: 40px; tint: Theme.muted; clicked => { root.act("next"); } }
        }
    }
}

export component AssistantHome inherits Rectangle {
    in property <string> time;
    in property <string> date;
    in property <AssistantData> data;
    in property <[RowData]> rows;
    in property <image> art;
    in property <bool> has-art;
    in property <image> camera-frame;
    in property <bool> connected;
    in property <bool> mic-muted;
    in property <string> timer-text;
    callback act(string, string);
    callback media-act(string);
    callback open-media();
    callback open-weather();
    callback open-dashboard();
    callback open-settings();
    callback camera-full();
    background: Theme.background;

    in property <int> reset;
    changed reset => {
        flick.content-y = 0px;
    }

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: root.width;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 4px;
            padding-bottom: 20px;
            spacing: 8px;

            // Status: wake word hint, timer, connection, dashboard, settings.
            HorizontalLayout {
                height: 40px;
                spacing: 8px;
                Icon {
                    text: root.mic-muted ? "\u{F036D}" : "\u{F036C}";
                    font-size: 18px;
                    color: root.mic-muted ? #ef4444 : Theme.faint;
                }
                Text {
                    text: root.data.hint;
                    font-size: 14px;
                    color: Theme.faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.timer-text != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 30px;
                        width: timer-row.preferred-width + 18px;
                        border-radius: 15px;
                        background: #f59e0b30;
                        timer-row := HorizontalLayout {
                            x: 9px;
                            spacing: 4px;
                            Icon { text: "\u{F051B}"; font-size: 17px; color: #f59e0b; }
                            Text { text: root.timer-text; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.connected ? #22c55e : #ef4444;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton { icon: "\u{F056E}"; size: 38px; tint: Theme.muted; clicked => { root.open-dashboard(); } }
                }
                VerticalLayout {
                    alignment: center;
                    MarkButton { size: 38px; clicked => { root.open-settings(); } }
                }
            }

            // Clock and date | current weather.
            HorizontalLayout {
                height: 112px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text { text: root.time; font-size: 84px; font-weight: 700; color: Theme.text; }
                    Text { text: root.date; font-size: 17px; color: Theme.muted; overflow: elide; }
                }
                if root.data.has-weather: Rectangle {
                    width: 168px;
                    TouchArea { clicked => { root.open-weather(); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            Icon { text: root.data.weather-icon; font-size: 46px; color: Theme.text; }
                            Text {
                                text: root.data.temperature;
                                font-size: 42px;
                                font-weight: 700;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.data.condition;
                            font-size: 15px;
                            color: Theme.text;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                        Text {
                            text: root.data.details;
                            font-size: 12px;
                            color: Theme.muted;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }
            }

            if root.data.has-weather && root.data.hourly.length > 0: Rectangle {
                height: 92px;
                border-radius: Theme.radius;
                background: Theme.card;
                TouchArea { clicked => { root.open-weather(); } }
                HorizontalLayout {
                    padding: 6px;
                    for f in root.data.hourly: ForecastCell { item: f; horizontal-stretch: 1; }
                }
            }

            if root.data.has-media: MediaCard {
                data: root.data;
                art: root.art;
                has-art: root.has-art;
                act(a) => { root.media-act(a); }
                open => { root.open-media(); }
            }

            for row in root.rows: RowView {
                data: row;
                camera-frame: root.camera-frame;
                act(e, a) => { root.act(e, a); }
                camera-full => { root.camera-full(); }
            }

            if root.data.setup-hint != "": Text {
                text: root.data.setup-hint;
                font-size: 13px;
                color: Theme.faint;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}

// Full-screen conversation. state: 1 listening, 2 thinking, 3 answer, 4 error.
export component AssistFull inherits Rectangle {
    in property <int> state;
    in property <string> heard;
    in property <string> answer;
    callback dismiss();
    property <color> tone: root.state == 1 ? #3b82f6 : root.state == 2 ? #f59e0b : root.state == 4 ? #ef4444 : #22c55e;
    background: Theme.background;
    TouchArea { clicked => { root.dismiss(); } }

    // Activity bars: moving while listening / thinking, still with the answer.
    for i in 5: Rectangle {
        property <length> h: root.state <= 2
            ? 14px + 34px * abs(sin((animation-tick() / 1ms) * (root.state == 1 ? 0.40deg : 0.25deg) + i * 55deg))
            : 14px;
        x: root.width / 2 - 64px + i * 26px;
        y: 64px - self.h / 2;
        width: 14px;
        height: self.h;
        border-radius: 7px;
        background: root.tone;
    }

    VerticalLayout {
        y: 112px;
        height: root.height - 132px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: 18px;
        alignment: start;
        Text {
            text: root.heard != "" ? root.heard : root.state == 1 ? "Listening…" : root.state == 2 ? "…" : "";
            font-size: 22px;
            color: Theme.muted;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if root.state >= 3: Text {
            text: root.answer;
            font-size: root.answer.character-count > 160 ? 21px : root.answer.character-count > 80 ? 25px : 31px;
            font-weight: 700;
            color: root.state == 4 ? #ef4444 : Theme.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Message from Home Assistant (nspanel_pro.show_message).
export component MessageCard inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> icon;
    callback dismiss();
    background: Theme.background;
    TouchArea { clicked => { root.dismiss(); } }
    VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 14px;
        Icon { text: root.icon != "" ? root.icon : "\u{F009E}"; font-size: 84px; color: Theme.accent; }
        if root.title != "": Text {
            text: root.title;
            font-size: 30px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.message != "": Text {
            text: root.message;
            font-size: root.message.character-count > 140 ? 18px : 22px;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text { text: "Tap to close"; font-size: 13px; color: Theme.faint; horizontal-alignment: center; }
    }
}

export component WeatherFull inherits Rectangle {
    in property <AssistantData> data;
    callback close();
    background: Theme.background;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            RoundButton { icon: "\u{F0141}"; size: 44px; clicked => { root.close(); } }
            Text { text: "Weather"; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
        }
        Flickable {
            content-height: wcol.preferred-height;
            wcol := VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    height: 92px;
                    spacing: 12px;
                    Icon { text: root.data.weather-icon; font-size: 76px; color: Theme.text; }
                    Text { text: root.data.temperature; font-size: 60px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: root.data.condition; font-size: 20px; color: Theme.text; overflow: elide; }
                        Text { text: root.data.details; font-size: 14px; color: Theme.muted; wrap: word-wrap; }
                    }
                }
                if root.data.hourly.length > 0: Rectangle {
                    height: 92px;
                    border-radius: Theme.radius;
                    background: Theme.card;
                    HorizontalLayout {
                        padding: 6px;
                        for f in root.data.hourly: ForecastCell { item: f; horizontal-stretch: 1; }
                    }
                }
                Rectangle {
                    border-radius: Theme.radius;
                    background: Theme.card;
                    height: days.preferred-height;
                    days := VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        for d in root.data.daily: HorizontalLayout {
                            height: 40px;
                            spacing: 10px;
                            Text { text: d.label; width: 76px; font-size: 16px; color: Theme.text; vertical-alignment: center; }
                            Icon { text: d.icon; width: 36px; font-size: 26px; color: Theme.text; }
                            Text { text: d.precip; horizontal-stretch: 1; font-size: 13px; color: #38bdf8; vertical-alignment: center; }
                            Text { text: d.temp; width: 48px; font-size: 17px; font-weight: 700; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: d.low; width: 44px; font-size: 15px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        if root.data.daily.length == 0: Text {
                            height: 40px;
                            text: "No daily forecast from this weather entity";
                            font-size: 14px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component MediaFull inherits Rectangle {
    in property <AssistantData> data;
    in property <image> art;
    in property <bool> has-art;
    callback close();
    callback act(string);
    callback volume(float);
    background: Theme.background;
    TouchArea { }
    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Artwork { width: 200px; height: 200px; art: root.art; has-art: root.has-art; icon-size: 96px; }
        }
        Text {
            text: root.data.media.title != "" ? root.data.media.title : root.data.media.name;
            font-size: 22px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.data.media.artist + (root.data.media-album != "" ? " · " + root.data.media-album : "");
            font-size: 15px;
            color: Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 26px;
            VerticalLayout { alignment: center; RoundButton { icon: "\u{F04AE}"; size: 52px; clicked => { root.act("prev"); } } }
            RoundButton {
                icon: root.data.media.playing ? "\u{F03E4}" : "\u{F040A}";
                size: 72px;
                clicked => { root.act("play_pause"); }
            }
            VerticalLayout { alignment: center; RoundButton { icon: "\u{F04AD}"; size: 52px; clicked => { root.act("next"); } } }
        }
        BigSlider {
            title: "Volume";
            value: root.data.media.volume / 100;
            changed(v) => { root.volume(v); }
        }
    }
    RoundButton { x: 12px; y: 12px; icon: "\u{F0141}"; size: 44px; clicked => { root.close(); } }
}
