// Dashboard rows: heading, tile pair, shutter, climate, media, camera.
// Row heights are fixed per kind; the app (dashboard.rs) uses the same values.
// Tapping a tile's icon toggles it, tapping the rest opens the details
// ("tap"; the app decides between details and toggle).

import { Theme } from "theme.slint";
import { Icon, RoundButton } from "widgets.slint";

export struct TileData {
    entity: string,
    name: string,
    icon: string,
    state: string,
    accent: color,
    on: bool,
    available: bool,
    kind: int,          // 0 read-only, 1 toggle, 2 cover, 3 climate, 4 media, 5 camera
    current: string,    // climate: current temperature
    target: string,     // climate: target temperature
    mode: string,       // climate: hvac mode text
    title: string,      // media: title
    artist: string,     // media: artist
    playing: bool,
    volume: int,        // media: volume 0..100
}

export struct RowData {
    kind: int,          // 0 heading, 1 tile pair, 2 cover, 3 climate, 4 media, 5 camera
    title: string,
    a: TileData,
    b: TileData,
    has-b: bool,
}

component IconBadge inherits Rectangle {
    in property <TileData> data;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: data.on ? data.accent.with-alpha(0.22) : Theme.badge-off;
    animate background { duration: 150ms; }
    Icon {
        text: root.data.icon;
        font-size: 26px;
        color: root.data.on ? root.data.accent : Theme.muted;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component NameState inherits VerticalLayout {
    in property <TileData> data;
    alignment: center;
    spacing: 2px;
    Text {
        text: root.data.name;
        font-size: 17px;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        text: root.data.state;
        font-size: 14px;
        color: Theme.muted;
        overflow: elide;
    }
}

component Card inherits Rectangle {
    in property <TileData> data;
    border-radius: Theme.radius;
    background: data.on ? Theme.card-on : Theme.card;
    opacity: data.available ? 1 : 0.5;
    drop-shadow-blur: Theme.dark ? 0px : 6px;
    drop-shadow-color: #00000018;
    animate background { duration: 150ms; }
}

export component Tile inherits Card {
    callback act(string, string);
    body := TouchArea {
        clicked => { root.act(root.data.entity, "tap"); }
    }
    Rectangle {
        background: body.pressed ? Theme.card-pressed.with-alpha(0.5) : transparent;
        border-radius: Theme.radius;
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            IconBadge {
                data: root.data;
                clicked => { root.act(root.data.entity, root.data.kind == 1 ? "toggle" : "tap"); }
            }
        }
        NameState { data: root.data; }
    }
}

export component HeadingRow inherits Text {
    vertical-alignment: bottom;
    font-size: 19px;
    font-weight: 700;
    color: Theme.text;
}

export component CoverRow inherits Card {
    callback act(string, string);
    TouchArea {
        clicked => { root.act(root.data.entity, "tap"); }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            IconBadge {
                data: root.data;
                clicked => { root.act(root.data.entity, "tap"); }
            }
        }
        NameState { data: root.data; }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                RoundButton { icon: "\u{F005D}"; clicked => { root.act(root.data.entity, "open"); } }
                RoundButton { icon: "\u{F04DB}"; clicked => { root.act(root.data.entity, "stop"); } }
                RoundButton { icon: "\u{F0045}"; clicked => { root.act(root.data.entity, "close"); } }
            }
        }
    }
}

export component ClimateRow inherits Card {
    callback act(string, string);
    TouchArea {
        clicked => { root.act(root.data.entity, "tap"); }
    }
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                IconBadge {
                    data: root.data;
                    clicked => { root.act(root.data.entity, "mode_toggle"); }
                }
                NameState { data: root.data; }
            }
            Text {
                text: "Now " + root.data.current;
                font-size: 15px;
                color: Theme.muted;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                RoundButton { icon: "\u{F0374}"; size: 48px; clicked => { root.act(root.data.entity, "temp_down"); } }
            }
            Text {
                width: 106px;
                text: root.data.target;
                font-size: 32px;
                font-weight: 700;
                color: root.data.on ? root.data.accent : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                RoundButton { icon: "\u{F0415}"; size: 48px; clicked => { root.act(root.data.entity, "temp_up"); } }
            }
        }
    }
}

export component MediaRow inherits Card {
    callback act(string, string);
    TouchArea {
        clicked => { root.act(root.data.entity, "tap"); }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                IconBadge {
                    data: root.data;
                    clicked => { root.act(root.data.entity, "tap"); }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: root.data.name + " · " + root.data.state; font-size: 15px; color: Theme.muted; overflow: elide; }
                Text { text: root.data.title; font-size: 17px; color: Theme.text; overflow: elide; }
                Text { text: root.data.artist; font-size: 14px; color: Theme.muted; overflow: elide; }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: space-between;
            HorizontalLayout {
                spacing: 8px;
                RoundButton { icon: "\u{F04AE}"; clicked => { root.act(root.data.entity, "prev"); } }
                RoundButton {
                    icon: root.data.playing ? "\u{F03E4}" : "\u{F040A}";
                    tint: root.data.accent;
                    clicked => { root.act(root.data.entity, "play_pause"); }
                }
                RoundButton { icon: "\u{F04AD}"; clicked => { root.act(root.data.entity, "next"); } }
            }
            HorizontalLayout {
                spacing: 8px;
                RoundButton { icon: "\u{F075E}"; clicked => { root.act(root.data.entity, "vol_down"); } }
                Text {
                    width: 54px;
                    text: root.data.volume + " %";
                    font-size: 15px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                RoundButton { icon: "\u{F075D}"; clicked => { root.act(root.data.entity, "vol_up"); } }
            }
        }
    }
}

export component CameraRow inherits Rectangle {
    in property <TileData> data;
    in property <image> frame;
    callback open-full();
    border-radius: Theme.radius;
    background: #000000;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: cover;
    }
    Rectangle {
        y: parent.height - 34px;
        height: 34px;
        background: #00000099;
        Text {
            x: 12px;
            text: root.data.name;
            font-size: 15px;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.open-full(); }
    }
}

export component RowView inherits Rectangle {
    in property <RowData> data;
    in property <image> camera-frame;
    callback act(string, string);
    callback camera-full();
    height: data.kind == 0 ? 44px : data.kind == 1 ? 84px : data.kind == 2 ? 84px : data.kind == 3 ? 124px
          : data.kind == 4 ? 132px : 252px;

    if root.data.kind == 0: HeadingRow {
        x: 4px;
        width: parent.width - 4px;
        height: parent.height - 6px;
        horizontal-alignment: left;
        text: root.data.title;
    }
    if root.data.kind == 1: Rectangle {
        width: parent.width;
        height: parent.height;
        Tile {
            x: 0;
            width: (parent.width - 12px) / 2;
            height: parent.height;
            data: root.data.a;
            act(e, a) => { root.act(e, a); }
        }
        if root.data.has-b: Tile {
            x: (parent.width + 12px) / 2;
            width: (parent.width - 12px) / 2;
            height: parent.height;
            data: root.data.b;
            act(e, a) => { root.act(e, a); }
        }
    }
    if root.data.kind == 2: CoverRow {
        width: parent.width;
        height: parent.height;
        data: root.data.a;
        act(e, a) => { root.act(e, a); }
    }
    if root.data.kind == 3: ClimateRow {
        width: parent.width;
        height: parent.height;
        data: root.data.a;
        act(e, a) => { root.act(e, a); }
    }
    if root.data.kind == 4: MediaRow {
        width: parent.width;
        height: parent.height;
        data: root.data.a;
        act(e, a) => { root.act(e, a); }
    }
    if root.data.kind == 5: CameraRow {
        width: parent.width;
        height: parent.height;
        data: root.data.a;
        frame: root.camera-frame;
        open-full => { root.camera-full(); }
    }
}
