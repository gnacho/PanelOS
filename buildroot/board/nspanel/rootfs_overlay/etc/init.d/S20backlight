#!/bin/sh
# Switch the backlight on at boot.

BL=/sys/class/backlight/backlight

case "$1" in
start)
	if [ -w "$BL/brightness" ]; then
		# 70.6 %, the brightness of the bootloader logo and the boot animation
		max=$(cat "$BL/max_brightness" 2>/dev/null || echo 255)
		echo $((max * 706 / 1000)) > "$BL/brightness"
		echo "<5>nspanel: backlight on" > /dev/kmsg
	fi
	;;
stop | restart | reload)
	;;
esac
exit 0
