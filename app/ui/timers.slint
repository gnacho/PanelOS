// Alarms, timers and stopwatch on one panel. Each function can be switched off; when more than one is
// on, tabs at the top switch between them (no separate panels).
// Colours: colourful (every timer and alarm its own vibrant colour, the app assigns them) or one colour
// (the panel colour) — one setting for the whole panel. Themes for the timers: 0 plain, 1 kitchen dial,
// 2 hourglass, 3 synthwave (four scenes with their own colours, no colour setting), 4 flip cards.
// Rings and lines are Paths (the software renderer draws arcs, it can't rotate or clip round). A Path
// fits its stroke inside its own box (the drawing shrinks by one stroke width and moves by half of it),
// so every stroked Path here gets a box one stroke width larger to keep its coordinates exact.
// Images are drawn at their exact size (the renderer scales without filtering). Coloured shapes are a
// white mask (colorize = the colour) with a grey + alpha shading layer on top.
import { Theme, Act } from "theme.slint";
import { Icon } from "widgets.slint";
import { FlapCard } from "panels.slint";
import { Keyboard } from "overlays.slint";

export struct TimerItem {
    label: string,      // "Pasta", "" when unnamed
    remaining: float,   // seconds
    total: float,       // seconds
    running: bool,      // false = paused
    tint: color,        // its colour (colourful mode) or the panel colour
}

export struct AlarmItem {
    time: string,       // "6:45"
    days: string,       // "Mon–Fri"
    label: string,      // "Wake up"
    on: bool,
    tint: color,        // its colour (colourful mode) or the panel colour
}

// synthwave: a pixel car pulling away from the viewer along a floor line (the app sends one at a time:
// a random line, never the last one, a random 10–30 s from below the front edge to the horizon; the next
// one comes when it is gone)
export struct SwCar {
    line: float,        // which floor line (0 = the middle one, negative = left)
    kind: int,          // 0 wedge with a rear wing, 1 flat tail with four round lights, 2 rounded fastback
    tint: color,        // its colour (random, vivid)
    born: float,        // the scene clock (seconds) when it appeared
    dur: float,         // seconds from below the front edge to the horizon
}

// text and line colour that follows the theme (the synthwave scene, the ringing screen, the flip box and the kitchen
// knob keep their own colours)
global TFg { out property <color> c: Theme.dark ? #ffffff : #101114; }

component Ring inherits Rectangle {
    in property <float> fr;             // 0..1 of the circle, from the top, clockwise
    in property <length> stroke: 10px;
    in property <color> arc;
    in property <color> track: TFg.c.with-alpha(0.12);
    property <float> r: (self.width - self.stroke) / 2 / 1px;
    property <float> c: self.width / 2 / 1px;
    property <angle> a: min(0.9999, max(0, root.fr)) * 360deg;
    Rectangle { border-radius: self.width / 2; border-width: root.stroke; border-color: root.track; }
    if root.fr > 0.001: Path {
        x: -root.stroke / 2; y: -root.stroke / 2; width: root.width + root.stroke; height: root.height + root.stroke;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.arc; stroke-width: root.stroke;
        commands: "M " + root.c + " " + (root.c - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.a > 180deg ? "1" : "0") + " 1 "
            + (root.c + root.r * Math.sin(root.a)) + " " + (root.c - root.r * Math.cos(root.a));
    }
}

// A straight stroke in the 480 × 480 screen frame (box grown by the stroke width, see above).
component Seg inherits Path {
    in property <float> x1;
    in property <float> y1;
    in property <float> x2;
    in property <float> y2;
    x: -self.stroke-width / 2; y: -self.stroke-width / 2;
    width: 480px + self.stroke-width; height: 480px + self.stroke-width;
    viewbox-width: 480; viewbox-height: 480;
    commands: "M " + root.x1 + " " + root.y1 + " L " + root.x2 + " " + root.y2;
}

// A glowing tube: wide faint halos, the colour, a white core; the unused part a dim tube.
component NeonRing inherits Rectangle {
    in property <float> fr;
    in property <length> stroke: 8px;
    in property <color> glow;
    in property <bool> paused;
    property <float> k: root.paused ? 0.5 : 1;
    Ring { x: -6px; y: -6px; width: root.width + 12px; height: root.height + 12px; stroke: root.stroke + 12px; fr: 0; track: root.glow.with-alpha(0.05); }
    Ring { width: root.width; height: root.height; stroke: root.stroke; fr: 0; track: root.glow.with-alpha(0.16); }
    Ring { x: -12px; y: -12px; width: root.width + 24px; height: root.height + 24px; stroke: root.stroke + 24px; track: transparent; fr: root.fr; arc: root.glow.with-alpha(0.06 * root.k); }
    Ring { x: -6px; y: -6px; width: root.width + 12px; height: root.height + 12px; stroke: root.stroke + 12px; track: transparent; fr: root.fr; arc: root.glow.with-alpha(0.13 * root.k); }
    Ring { x: -2px; y: -2px; width: root.width + 4px; height: root.height + 4px; stroke: root.stroke + 4px; track: transparent; fr: root.fr; arc: root.glow.with-alpha(0.32 * root.k); }
    Ring { width: root.width; height: root.height; stroke: root.stroke; track: transparent; fr: root.fr; arc: root.paused ? root.glow.with-alpha(0.6) : root.glow; }
    Ring { x: root.stroke * 0.35; y: root.stroke * 0.35; width: root.width - root.stroke * 0.7; height: root.height - root.stroke * 0.7; stroke: root.stroke * 0.3;
        track: transparent; fr: root.fr; arc: #ffffff.with-alpha(0.8 * root.k); }
}

// Neon lettering: a soft coloured glow, a thin dark rim that follows the glyphs, a white core.
component NeonText inherits Rectangle {
    in property <string> text;
    in property <length> size: 52px;
    in property <int> weight: 300;
    in property <color> glow;
    in property <color> rim;
    in property <color> core: #ffffff;
    for o in [{ x: -2.5, y: 0 }, { x: 2.5, y: 0 }, { x: 0, y: -2.5 }, { x: 0, y: 2.5 }]: Text {
        x: o.x * 1px; y: o.y * 1px; width: root.width; height: root.height; text: root.text; font-size: root.size; font-weight: root.weight;
        color: root.glow.with-alpha(0.38); horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    for o in [{ x: -1, y: -1 }, { x: 1, y: -1 }, { x: -1, y: 1 }, { x: 1, y: 1 }, { x: 0, y: -1.4 }, { x: 0, y: 1.4 }, { x: -1.4, y: 0 }, { x: 1.4, y: 0 }]: Text {
        x: o.x * 1px; y: o.y * 1px; width: root.width; height: root.height; text: root.text; font-size: root.size; font-weight: root.weight;
        color: root.rim; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    Text { width: root.width; height: root.height; text: root.text; font-size: root.size; font-weight: root.weight;
        color: root.core; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
}

component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 56px;
    in property <length> icon-size: 28px;
    in property <color> fill: TFg.c.with-alpha(0.12);
    in property <color> ink: TFg.c;
    in property <bool> outline;
    in property <color> line: TFg.c.with-alpha(0.30);
    in property <string> act;          // what a tap does (Act), with `act-value`
    in property <string> act-value;
    width: self.size; height: self.size; border-radius: self.size / 2;
    background: root.outline ? transparent : root.fill;
    border-width: root.outline ? 1.5px : 0px; border-color: root.line;
    opacity: rb-touch.pressed ? 0.6 : 1;
    Icon { width: parent.width; height: parent.height; text: root.icon; font-size: root.icon-size; color: root.ink; }
    rb-touch := TouchArea { clicked => { if root.act != "" { Act.act(root.act, root.act-value); } } }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <length> h: 48px;
    in property <color> fill: TFg.c.with-alpha(0.12);
    in property <color> ink: TFg.c;
    in property <color> line: transparent;
    in property <length> font-size: 16px;
    in property <string> act;
    in property <string> act-value;
    height: self.h; width: t.preferred-width + 36px; border-radius: self.h / 2; background: root.fill;
    border-width: root.line == transparent ? 0px : 1.5px; border-color: root.line;
    opacity: p-touch.pressed ? 0.6 : 1;
    t := Text { x: 18px; width: self.preferred-width; height: parent.height; text: root.text; font-size: root.font-size; font-weight: 600; color: root.ink; vertical-alignment: center; }
    p-touch := TouchArea { clicked => { if root.act != "" { Act.act(root.act, root.act-value); } } }
}

// +1 min · play / pause · remove, centred on a row
component TimerControls inherits HorizontalLayout {
    in property <bool> running;
    in property <color> tint;
    in property <length> play: 64px;
    in property <bool> neon;
    in property <int> index;
    alignment: center; spacing: 20px;
    VerticalLayout { alignment: center; Pill { act: "timers.add"; act-value: root.index; text: "+1 min"; h: 44px; ink: root.neon ? #ffffff : TFg.c; fill: root.neon ? #00000059 : TFg.c.with-alpha(0.12); line: root.neon ? root.tint.with-alpha(0.7) : transparent; } }
    RoundButton { size: root.play; icon-size: root.play * 0.52; fill: root.neon ? #00000059 : root.tint; ink: root.neon ? root.tint.mix(#ffffff, 0.6) : #ffffff; outline: false;
        border-width: root.neon ? 2px : 0px; border-color: root.tint;
        icon: root.running ? "\u{F03E4}" : "\u{F040A}"; act: "timers.toggle"; act-value: root.index; }
    VerticalLayout { alignment: center; RoundButton { act: "timers.cancel"; act-value: root.index; size: 44px; icon-size: 22px; fill: root.neon ? #00000059 : transparent; outline: !root.neon; ink: root.neon ? #ffffff : TFg.c;
        border-width: 1.5px; border-color: root.neon ? root.tint.with-alpha(0.6) : TFg.c.with-alpha(0.30); icon: "\u{F0156}"; } }
}

// a settings chip
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> check;          // multi-choice: a tick when on
    in property <color> fill: Theme.accent;
    width: ct.preferred-width + 26px + (root.check && root.on ? 20px : 0px); height: 32px; border-radius: 16px;
    background: root.on ? (root.check ? TFg.c.with-alpha(0.18) : TFg.c) : transparent; border-width: root.on ? 0px : 1px; border-color: TFg.c.with-alpha(0.25);
    if root.check && root.on: Icon { x: 12px; width: 16px; height: parent.height; text: "\u{F012C}"; font-size: 15px; color: TFg.c; }
    ct := Text { x: root.check && root.on ? 33px : 13px; width: self.preferred-width; height: parent.height; text: root.text; font-size: 14px; font-weight: 500; color: root.on && !root.check ? (Theme.dark ? #101114 : #F5F3EE) : TFg.c; vertical-alignment: center; }
}

// The synthwave scene: sky, floor with lines gliding towards the viewer, a shooting star now and then
// (stars scene), pixel cars pulling away, swaying palms (beach). Used by the timers page and, with a
// day / night crossfade, by the home page background.
export component SynthScene inherits Rectangle {
    in property <image> back;              // sky (480 x 330)
    in property <image> floor;             // floor (480 x 150)
    in property <image> back2;             // second sky / floor faded in on top by mix (home page: night)
    in property <image> floor2;
    in property <float> mix;
    in property <int> scene;               // 0 sunset, 1 city, 2 beach, 3 stars
    in property <color> grid;              // the moving floor lines
    in property <float> t;                 // seconds (the floor glides 1.2 line spacings per second)
    in property <[SwCar]> cars;
    in property <image> palm-l;
    in property <image> palm-r;
    in property <float> star-k: 1;         // shooting star strength (home page: only at night)
    // the sky and the floor; during a crossfade (home page: day <-> night) the second pair on top
    if root.mix < 0.999: Image { x: 0; y: 0; width: 480px; height: 330px; source: root.back; }
    if root.mix < 0.999: Image { x: 0; y: 330px; width: 480px; height: 150px; source: root.floor; }
    if root.mix > 0.001: Image { x: 0; y: 0; width: 480px; height: 330px; source: root.back2; opacity: root.mix; }
    if root.mix > 0.001: Image { x: 0; y: 330px; width: 480px; height: 150px; source: root.floor2; opacity: root.mix; }
    // floor lines gliding towards the viewer (one line spacing every 0.83 s)
    for k in 18: fl := Rectangle {
        property <float> d: 0.7 * (k + 1 - (root.t * 1.2 - Math.floor(root.t * 1.2))) + 0.3;
        property <float> yy: 330 + 150 / self.d;
        property <float> a: max(0.1, min(1, (self.yy - 331) / 70));
        visible: self.yy < 481 && self.yy > 332;
        x: 0; y: Math.round(self.yy - 2) * 1px; width: 480px; height: 5px;
        background: root.grid.with-alpha(0.10 * self.a);
        Rectangle { y: 1px; height: 3px; background: root.grid.with-alpha(0.22 * fl.a); }
        Rectangle { y: 2px; height: fl.yy > 410 ? 2px : 1px; background: root.grid.with-alpha(0.9 * fl.a); }
    }
    // shooting star now and then (stars scene, every 10 s)
    property <float> sh: (root.t / 10) - Math.floor(root.t / 10);
    if root.scene == 3 && root.sh < 0.16 && root.star-k > 0.01: star := Rectangle {
        opacity: root.star-k;
        property <float> p: root.sh / 0.16;
        property <float> hx: 270 + self.p * 200;
        property <float> hy: 112 + self.p * 52;
        Seg { stroke: #ffffff26; stroke-width: 3px; x1: star.hx - 64; y1: star.hy - 18; x2: star.hx; y2: star.hy; }
        Seg { stroke: #ffffffb3; stroke-width: 1.4px; x1: star.hx - 40; y1: star.hy - 11; x2: star.hx; y2: star.hy; }
        Rectangle { x: (star.hx - 1.5) * 1px; y: (star.hy - 1.5) * 1px; width: 3px; height: 3px; border-radius: 1.5px; background: #ffffff; }
    }
    // pixel cars pulling away along a floor line, big near, smaller towards the horizon (far ones first)
    for c in root.cars: car := Rectangle {
        // depth: 0.46 = still under the bottom edge … 1 = tyres on the edge, 176 px wide … 60 = 3 px, gone
        property <float> age: max(0, root.t - c.born);
        property <float> d: 0.46 * Math.pow(60 / 0.46, min(1, self.age / max(1, c.dur)));
        property <float> sp: 43.8 / self.d + 2.2;           // floor line spacing at this depth
        property <float> s: 176 / 48 / car.d;                // sprite scale: 176 px wide at d 1, shrinking to nothing
        property <float> cx: 240 + c.line * self.sp;         // on its line
        property <float> gy: 330 + 150 / car.d;              // ground under the tyres
        property <float> sm: max(0, min(1, (1.8 - car.d) / 0.8));  // smoke only while it pulls away (near)
        if car.d < 59.9: Image { x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            source: c.kind == 0 ? @image-url("timers/sw/pcar-0-paint.png") : c.kind == 1 ? @image-url("timers/sw/pcar-1-paint.png") : @image-url("timers/sw/pcar-2-paint.png");
            colorize: c.tint; }
        if car.d < 59.9: Image { x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            source: c.kind == 0 ? @image-url("timers/sw/pcar-0-shade.png") : c.kind == 1 ? @image-url("timers/sw/pcar-1-shade.png") : @image-url("timers/sw/pcar-2-shade.png"); }
        if car.d < 59.9: Image { x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            source: c.kind == 0 ? @image-url("timers/sw/pcar-0-fixed.png") : c.kind == 1 ? @image-url("timers/sw/pcar-1-fixed.png") : @image-url("timers/sw/pcar-2-fixed.png"); }
        // a little pixel smoke from the rear tyres, drifting towards the viewer
        if car.sm > 0: Rectangle {
            for p in 6: Rectangle {
                property <float> side: p < 3 ? -1 : 1;
                property <float> ph: car.age * 2 + Math.mod(p, 3) / 3 - Math.floor(car.age * 2 + Math.mod(p, 3) / 3);
                property <float> sz: Math.round((1 + 2 * self.ph) * car.s);
                x: (car.cx + self.side * (17 + 3 * self.ph) * car.s - self.sz / 2) * 1px;
                y: (car.gy - 3 * car.s + self.ph * 7 * car.s - self.sz / 2) * 1px;
                width: self.sz * 1px; height: self.sz * 1px;
                background: #e6dcf5.with-alpha(0.5 * (1 - self.ph) * car.sm);
            }
        }
    }
    // swaying palms (beach)
    if root.scene == 2: Image { x: -34px; y: 112px; width: 210px; height: 300px; source: root.palm-l; }
    if root.scene == 2: Image { x: 304px; y: 112px; width: 210px; height: 300px; source: root.palm-r; }
}

export component TimersPage inherits Rectangle {
    in property <bool> alarm-on: true;    // functions switched on in the settings
    in property <bool> timer-on: true;
    in property <bool> watch-on: true;
    in property <int> mode: 1;            // 0 alarms, 1 timers, 2 stopwatch
    in property <int> theme;              // timers: 0 plain, 1 kitchen, 2 hourglass, 3 synthwave, 4 flip
    in property <[TimerItem]> timers;
    in property <int> pick;               // kitchen, hourglass, flip: the timer shown big
    in property <bool> quick;             // the quick starts over the running timers (the + cell)
    in property <[AlarmItem]> alarms;
    in property <string> next-alarm;      // "6:45 · in 14 h 52 min"
    in property <color> next-tint: #ffb21e;
    in property <float> watch: 0;         // stopwatch, seconds
    in property <bool> watch-running;
    in property <[float]> laps;           // lap times, newest first
    in property <color> watch-tint: #3d9bff;
    in property <bool> ringing;           // a timer or an alarm rings (full screen)
    in property <bool> ring-alarm;        // … it is an alarm
    in property <string> ring-label;
    in property <string> ring-time;       // alarm: "6:45"
    in property <float> ring-over;        // timer: seconds since it finished
    in property <color> ring-tint: #e8262d;
    in property <float> pulse;            // 0..1, the ringing background breathes (app animation)
    in property <bool> settings;          // the settings sheet
    in property <bool> colourful: true;
    // hourglass: the app picks the sand frame for the time left (48 levels) and the stream frame
    in property <image> hg-sand-mask;
    in property <image> hg-sand-shade;
    in property <float> hg-peak: 214;     // top of the heap in the bottom bulb (image y)
    in property <image> hg-stream-mask;
    in property <image> hg-stream-shade;
    // synthwave: scene 0 sunset, 1 city, 2 beach, 3 stars (the app picks one at random when the page opens,
    // unless one is chosen); its pictures; the animation clock; passing cars; the palms' current frames
    in property <int> sw-scene;
    in property <int> sw-choice: -1;      // settings: -1 surprise me, 0..3 a fixed scene
    in property <image> sw-back;
    in property <image> sw-floor;
    in property <float> sw-t;             // seconds
    in property <[SwCar]> sw-cars;
    in property <image> sw-palm-l;
    in property <image> sw-palm-r;
    // alarm editor (new alarm or a tap on one) and its keyboard for the label
    in property <bool> edit;
    in property <bool> edit-new: true;
    in property <int> edit-h: 6;
    in property <int> edit-m: 45;
    in property <[bool]> edit-days: [true, true, true, true, true, false, false];
    in property <string> edit-label;
    in property <int> edit-sound;          // index into sounds; sounds.length = the one set in Home Assistant
    in property <string> edit-ha-sound;    // a sound set in Home Assistant for this alarm (music or own file), "" none
    in property <bool> edit-keyboard;
    in property <bool> edit-info;          // the ⓘ note on sounds
    in property <int> kb-layer;
    in property <color> edit-tint: #ffb21e;
    property <[string]> sounds: ["Rise and Shine", "Up and At 'Em", "Early Bird", "Saved by the Bell", "Old School", "Neon Sunrise"];

    pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
    pure function clock(t: float) -> string {
        t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(Math.ceil(t) / 60), 60)) + ":" + root.two(Math.mod(Math.ceil(t), 60))
            : Math.floor(Math.ceil(t) / 60) + ":" + root.two(Math.mod(Math.ceil(t), 60))
    }
    pure function name(l: string) -> string { l != "" ? l : "Timer" }
    property <int> n: root.timers.length;
    property <int> funcs: (root.alarm-on ? 1 : 0) + (root.timer-on ? 1 : 0) + (root.watch-on ? 1 : 0);
    property <length> top: root.funcs > 1 ? 98px : 52px;          // content starts under the tabs
    property <TimerItem> cur: root.n > 0 ? root.timers[min(root.pick, root.n - 1)] : { label: "", remaining: 0, total: 1, running: false, tint: #e8262d };
    property <float> fr: root.cur.total > 0 ? root.cur.remaining / root.cur.total : 0;
    property <bool> synth: !root.ringing && root.mode == 1 && root.theme == 3;
    property <[color]> sw-rings: [#ff2a6d, #ffd319, #ff8b3d, #c86bfa, #00e5ff, #ff2e88, #f9f871, #8a5cff,
                                  #ff6ec7, #00f0c8, #ffb86b, #a17bff, #7df9ff, #b967ff, #01ffc3, #ff71ce];
    property <[color]> sw-grids: [#ff2bd6, #00e5ff, #00f0c8, #b967ff];
    property <[color]> sw-deep: [#1d0634, #060424, #241047, #08051e];
    property <color> grid: root.sw-grids[root.sw-scene];
    property <color> deep: root.sw-deep[root.sw-scene];
    background: Theme.background;

    // ---------------------------------------------------------------- timers, plain
    if !root.ringing && root.mode == 1 && root.theme == 0 && root.n == 1: one := Rectangle {
        property <TimerItem> t: root.timers[0];
        Ring { x: (root.width - 240px) / 2; y: root.top + 4px; width: 240px; height: 240px; stroke: 12px;
            fr: one.t.total > 0 ? one.t.remaining / one.t.total : 0; arc: one.t.tint; opacity: one.t.running ? 1 : 0.55; }
        Text { x: (root.width - 180px) / 2; y: root.top + 66px; width: 180px; height: 24px; text: root.name(one.t.label); font-size: 18px; font-weight: 600;
            color: one.t.tint.mix(TFg.c, 0.55); horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Text { x: 0; y: root.top + 92px; width: root.width; height: 62px; text: root.clock(one.t.remaining); font-size: one.t.remaining >= 3600 ? 46px : 58px; font-weight: 600;
            color: TFg.c; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 0; y: root.top + 156px; width: root.width; height: 20px; text: one.t.running ? "of " + root.clock(one.t.total) : "Paused";
            font-size: 14px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
        TimerControls { x: 0; y: root.top + 262px; width: root.width; height: 64px; running: one.t.running; tint: one.t.tint; index: 0; }
    }
    if !root.ringing && root.mode == 1 && root.theme == 0 && root.n == 2: Rectangle {
        for t[i] in root.timers: Rectangle {
            x: 24px + i * 224px; y: root.top + 6px; width: 208px; height: 300px;
            Ring { x: 4px; y: 0; width: 200px; height: 200px; stroke: 10px; fr: t.total > 0 ? t.remaining / t.total : 0; arc: t.tint; opacity: t.running ? 1 : 0.55; }
            Text { x: 29px; y: 56px; width: 150px; height: 22px; text: root.name(t.label); font-size: 16px; font-weight: 600; color: t.tint.mix(TFg.c, 0.55);
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            Text { x: 0; y: 78px; width: 208px; height: 46px; text: root.clock(t.remaining); font-size: t.remaining >= 3600 ? 32px : 40px; font-weight: 600; color: TFg.c;
                horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 0; y: 124px; width: 208px; height: 18px; text: t.running ? "of " + root.clock(t.total) : "Paused"; font-size: 13px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
            HorizontalLayout {
                x: 0; y: 222px; width: 208px; height: 56px; alignment: center; spacing: 16px;
                RoundButton { size: 56px; icon-size: 30px; fill: t.tint; ink: #ffffff; icon: t.running ? "\u{F03E4}" : "\u{F040A}"; act: "timers.toggle"; act-value: i; }
                VerticalLayout { alignment: center; RoundButton { size: 44px; icon-size: 22px; outline: true; icon: "\u{F0156}"; act: "timers.cancel"; act-value: i; } }
            }
        }
    }
    if !root.ringing && root.mode == 1 && root.theme == 0 && root.n >= 3: Rectangle {
        for c in 4: cell := Rectangle {
            x: 20px + Math.mod(c, 2) * 224px; y: root.top + Math.floor(c / 2) * 176px; width: 216px; height: 168px;
            border-radius: 20px; background: TFg.c.with-alpha(0.05);
            property <bool> has: c < root.n;
            property <TimerItem> t: self.has ? root.timers[c] : { label: "", remaining: 0, total: 0, running: false, tint: #ffffff };
            TouchArea { clicked => { Act.act(cell.has ? "timers.toggle" : "timers.quick", c); } }
            if cell.has: Ring { x: (cell.width - 116px) / 2; y: 12px; width: 116px; height: 116px; stroke: 8px;
                fr: cell.t.total > 0 ? cell.t.remaining / cell.t.total : 0; arc: cell.t.tint; opacity: cell.t.running ? 1 : 0.55; }
            if cell.has: Text { x: 0; y: 12px + 36px; width: cell.width; height: 44px; text: root.clock(cell.t.remaining); font-size: cell.t.remaining >= 3600 ? 22px : 28px; font-weight: 600;
                color: TFg.c; horizontal-alignment: center; vertical-alignment: center; }
            if cell.has && !cell.t.running: Text { x: 0; y: 12px + 76px; width: cell.width; height: 14px; text: "Paused"; font-size: 11px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
            if cell.has: Text { x: 12px; y: 136px; width: cell.width - 24px; height: 22px; text: root.name(cell.t.label); font-size: 15px; font-weight: 600; color: cell.t.tint.mix(TFg.c, 0.55);
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            if !cell.has: Rectangle {
                Rectangle { x: (parent.width - 60px) / 2; y: 54px; width: 60px; height: 60px; border-radius: 30px; border-width: 1.5px; border-color: TFg.c.with-alpha(0.30);
                    Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 28px; color: TFg.c.with-alpha(0.80); } }
            }
        }
    }

    // ---------------------------------------------------------------- kitchen, hourglass, flip: one timer big, chips for the others
    property <bool> themed: !root.ringing && root.mode == 1 && (root.theme == 1 || root.theme == 2 || root.theme == 4) && root.n >= 1;
    property <length> vis: root.top + (root.n > 1 ? 38px : 0px);         // where the theme picture starts
    if root.themed && root.n > 1: HorizontalLayout {
        x: 0; y: root.top; width: root.width; height: 30px; alignment: center; spacing: 8px;
        for t[i] in root.timers: Rectangle {
            width: tl.preferred-width + 30px; height: 30px; border-radius: 15px;
            background: i == root.pick ? t.tint : t.tint.with-alpha(0.18);
            TouchArea { clicked => { Act.act("timers.pick", i); } }
            Rectangle { x: 10px; y: 11px; width: 8px; height: 8px; border-radius: 4px; background: i == root.pick ? #ffffff : t.tint; }
            tl := Text { x: 24px; width: self.preferred-width; height: parent.height; text: root.clock(t.remaining); font-size: 13px; font-weight: 600;
                color: i == root.pick ? #ffffff : t.tint.mix(TFg.c, 0.6); vertical-alignment: center; }
        }
    }
    if root.themed: TimerControls { x: 0; y: 384px; width: root.width; height: 56px; play: 56px; running: root.cur.running; tint: root.cur.tint; index: min(root.pick, root.n - 1); }

    // 1 kitchen: a turning dial (the minute under the pointer = what is left), the time on the knob.
    // Body, face light and knob are drawn layers; the minute ring turns under the fixed light.
    if root.themed && root.theme == 1: kit := Rectangle {
        property <float> cx: 240;
        property <float> cy: Math.round((root.vis / 1px + 380) / 2);
        property <float> rf: 94;
        property <float> mins: root.cur.remaining / 60;
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/shadow.png"); }
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/body-mask.png"); colorize: root.cur.tint; }
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/body-shade.png"); }
        Rectangle { x: (kit.cx - kit.rf) * 1px; y: (kit.cy - kit.rf) * 1px; width: 2 * kit.rf * 1px; height: self.width; border-radius: self.width / 2; background: #f1e8d6; }
        // minute ticks and numbers, turned so that the remaining minutes sit under the pointer
        for m in 60: tk := Rectangle {
            property <angle> a: (m - kit.mins) * 6deg;
            property <float> r1: kit.rf - (Math.mod(m, 5) == 0 ? 12 : 7);
            property <float> r2: kit.rf - 3;
            Seg { stroke: #3b352d; stroke-width: Math.mod(m, 5) == 0 ? 2px : 1px;
                x1: kit.cx + tk.r1 * Math.sin(tk.a); y1: kit.cy - tk.r1 * Math.cos(tk.a); x2: kit.cx + tk.r2 * Math.sin(tk.a); y2: kit.cy - tk.r2 * Math.cos(tk.a); }
        }
        for m in 12: Text {
            property <angle> a: (m * 5 - kit.mins) * 6deg;
            property <float> rn: kit.rf - 27;
            x: (kit.cx + self.rn * Math.sin(self.a) - 16) * 1px; y: (kit.cy - self.rn * Math.cos(self.a) - 10) * 1px; width: 32px; height: 20px;
            text: m * 5; font-size: 15px; font-weight: 700; color: #3b352d; horizontal-alignment: center; vertical-alignment: center;
        }
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/face-light.png"); }
        // knob with the time
        Image { x: (kit.cx - 62) * 1px; y: (kit.cy - 32) * 1px; width: 124px; height: 64px; source: @image-url("timers/kit/knob-shadow.png"); }
        Image { x: (kit.cx - 62) * 1px; y: (kit.cy - 32) * 1px; width: 124px; height: 64px; source: @image-url("timers/kit/knob-mask.png"); colorize: root.cur.tint.mix(#000000, 0.22); }
        Image { x: (kit.cx - 62) * 1px; y: (kit.cy - 32) * 1px; width: 124px; height: 64px; source: @image-url("timers/kit/knob-shade.png"); }
        Text { x: (kit.cx - 52) * 1px; y: (kit.cy - 22) * 1px; width: 104px; height: 44px; text: root.clock(root.cur.remaining); font-size: root.cur.remaining >= 3600 ? 18px : 22px; font-weight: 700;
            color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
    }

    // 2 hourglass: glass, wooden frame and sand drawn as layers; the app picks the sand frame
    // (the amount is true to the time left) and the stream frame while it runs; the time on the right
    if root.themed && root.theme == 2: hg := Rectangle {
        property <length> x0: 54px;
        property <length> y0: root.vis + max(0px, (380px - root.vis - 244px) / 2);
        property <bool> flowing: root.cur.running && root.fr > 0.002 && root.fr < 0.998;
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/floor-shadow.png"); }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/post-back.png"); }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/glass-back.png"); }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: root.hg-sand-mask; colorize: root.cur.tint; }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: root.hg-sand-shade; }
        if hg.flowing: Rectangle {
            x: hg.x0 + 84px; y: hg.y0 + 118px; width: 5px; height: max(0px, (root.hg-peak - 118) * 1px + 1px); clip: true;
            Image { x: 0; y: 0; width: 5px; height: 98px; source: root.hg-stream-mask; colorize: root.cur.tint; }
            Image { x: 0; y: 0; width: 5px; height: 98px; source: root.hg-stream-shade; }
        }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/glass-front.png"); }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/frame.png"); }
        // name, time, total on the right
        Text { x: 252px; y: hg.y0 + 118px - 64px; width: 210px; height: 24px; text: root.name(root.cur.label); font-size: 18px; font-weight: 600;
            color: root.cur.tint.mix(TFg.c, 0.55); overflow: elide; vertical-alignment: center; }
        Text { x: 250px; y: hg.y0 + 118px - 40px; width: 214px; height: 62px; text: root.clock(root.cur.remaining); font-size: root.cur.remaining >= 3600 ? 42px : 56px; font-weight: 600;
            color: TFg.c; vertical-alignment: center; }
        Text { x: 252px; y: hg.y0 + 118px + 24px; width: 210px; height: 20px; text: root.cur.running ? "of " + root.clock(root.cur.total) : "Paused"; font-size: 14px; color: TFg.c.with-alpha(0.50); vertical-alignment: center; }
    }

    // 4 flip: split-flap minutes and seconds on the timer's colour
    if root.themed && root.theme == 4: flp := Rectangle {
        property <bool> hrs: root.cur.remaining >= 3600;
        property <int> mm: self.hrs ? min(99, Math.floor(root.cur.remaining / 3600)) : Math.floor(Math.ceil(root.cur.remaining) / 60);
        property <int> ss: self.hrs ? Math.mod(Math.floor(root.cur.remaining / 60), 60) : Math.mod(Math.ceil(root.cur.remaining), 60);
        property <length> ch: 132px;
        property <length> cw: 82px;
        property <length> fy: (root.vis + 378px - self.ch) / 2 + 6px;
        Rectangle { x: 16px; y: root.vis; width: root.width - 32px; height: 378px - root.vis; border-radius: 22px; background: root.cur.tint.mix(#000000, 0.8);
            Rectangle { x: 18px; y: 3px; width: parent.width - 36px; height: 2px; border-radius: 1px; background: #ffffff40; } }
        Text { x: 32px; y: root.vis + 12px; width: root.width - 64px; height: 26px; text: root.name(root.cur.label); font-size: 18px; font-weight: 700; color: #ffffff;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        HorizontalLayout {
            x: 0; y: flp.fy; width: root.width; height: flp.ch; alignment: center; spacing: 8px;
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; old-digit: Math.floor(flp.mm / 10); new-digit: Math.floor(flp.mm / 10); flip: 1; }
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; old-digit: Math.mod(flp.mm, 10); new-digit: Math.mod(flp.mm, 10); flip: 1; }
            VerticalLayout { alignment: center; spacing: 26px;
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #ffffff; }
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #ffffff; } }
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; old-digit: Math.floor(flp.ss / 10); new-digit: Math.floor(flp.ss / 10); flip: 1; }
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; old-digit: Math.mod(flp.ss, 10); new-digit: Math.mod(flp.ss, 10); flip: 1; }
        }
        Text { x: 0; y: flp.fy + flp.ch + 10px; width: root.width; height: 20px; text: (flp.hrs ? "h : min  ·  " : "") + (root.cur.running ? "of " + root.clock(root.cur.total) : "Paused");
            font-size: 14px; color: #ffffffcc; horizontal-alignment: center; vertical-alignment: center; }
    }

    // ---------------------------------------------------------------- 3 synthwave: the scene, then the tubes
    if root.synth: syn := Rectangle {
        SynthScene { back: root.sw-back; floor: root.sw-floor; scene: root.sw-scene; grid: root.grid; t: root.sw-t; cars: root.sw-cars;
            palm-l: root.sw-palm-l; palm-r: root.sw-palm-r; }

        // one timer: a big tube, the controls at the bottom
        if root.n == 1: Rectangle {
            property <TimerItem> t: root.timers[0];
            property <color> g: root.sw-rings[root.sw-scene * 4];
            NeonRing { x: (root.width - 212px) / 2; y: root.top + 8px; width: 212px; height: 212px; stroke: 8px; glow: parent.g; paused: !parent.t.running;
                fr: parent.t.total > 0 ? parent.t.remaining / parent.t.total : 0; }
            NeonText { x: (root.width - 160px) / 2; y: root.top + 58px; width: 160px; height: 24px; text: root.name(parent.t.label); size: 17px; weight: 600;
                glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.45); }
            NeonText { x: 0; y: root.top + 84px; width: root.width; height: 62px; text: root.clock(parent.t.remaining); size: parent.t.remaining >= 3600 ? 42px : 54px; weight: 400;
                glow: parent.g; rim: root.deep; }
            NeonText { x: 0; y: root.top + 146px; width: root.width; height: 20px; text: parent.t.running ? "of " + root.clock(parent.t.total) : "PAUSED"; size: 13px; weight: 600;
                glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.6); }
            TimerControls { x: 0; y: 384px; width: root.width; height: 56px; play: 56px; running: parent.t.running; tint: parent.g; neon: true; index: 0; }
        }
        // two timers: tubes side by side, small controls under each
        if root.n == 2: Rectangle {
            for t[i] in root.timers: tc := Rectangle {
                property <color> g: root.sw-rings[root.sw-scene * 4 + i];
                x: 22px + i * 230px; y: root.top + 12px; width: 206px; height: 300px;
                NeonRing { x: 8px; y: 0; width: 190px; height: 190px; stroke: 7px; glow: parent.g; paused: !t.running; fr: t.total > 0 ? t.remaining / t.total : 0; }
                NeonText { x: 28px; y: 50px; width: 150px; height: 22px; text: root.name(t.label); size: 15px; weight: 600; glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.45); }
                NeonText { x: 0; y: 72px; width: 206px; height: 50px; text: root.clock(t.remaining); size: t.remaining >= 3600 ? 32px : 40px; weight: 400; glow: parent.g; rim: root.deep; }
                NeonText { x: 0; y: 122px; width: 206px; height: 18px; text: t.running ? "of " + root.clock(t.total) : "PAUSED"; size: 12px; weight: 600; glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.6); }
                HorizontalLayout {
                    x: 0; y: 206px; width: 206px; height: 52px; alignment: center; spacing: 14px;
                    RoundButton { size: 52px; icon-size: 28px; fill: #00000059; border-width: 2px; border-color: tc.g; ink: tc.g.mix(#ffffff, 0.6); icon: t.running ? "\u{F03E4}" : "\u{F040A}"; act: "timers.toggle"; act-value: i; }
                    VerticalLayout { alignment: center; RoundButton { size: 40px; icon-size: 20px; fill: #00000059; border-width: 1.5px; border-color: tc.g.with-alpha(0.6); icon: "\u{F0156}"; act: "timers.cancel"; act-value: i; } }
                }
            }
        }
        // three or four: a grid of smaller tubes
        if root.n >= 3: Rectangle {
            for c in 4: scell := Rectangle {
                x: 20px + Math.mod(c, 2) * 224px; y: root.top + Math.floor(c / 2) * 176px; width: 216px; height: 168px;
                property <bool> has: c < root.n;
                property <TimerItem> t: self.has ? root.timers[c] : { label: "", remaining: 0, total: 0, running: false, tint: #ffffff };
                property <color> g: root.sw-rings[root.sw-scene * 4 + Math.mod(c, 4)];
                TouchArea { clicked => { Act.act(scell.has ? "timers.toggle" : "timers.quick", c); } }
                if scell.has: NeonRing { x: (scell.width - 118px) / 2; y: 10px; width: 118px; height: 118px; stroke: 6px; glow: scell.g; paused: !scell.t.running;
                    fr: scell.t.total > 0 ? scell.t.remaining / scell.t.total : 0; }
                if scell.has: NeonText { x: 0; y: 10px + 38px; width: scell.width; height: 42px; text: root.clock(scell.t.remaining); size: scell.t.remaining >= 3600 ? 22px : 28px; weight: 400;
                    glow: scell.g; rim: root.deep; }
                if scell.has && !scell.t.running: NeonText { x: 0; y: 10px + 76px; width: scell.width; height: 14px; text: "PAUSED"; size: 10px; weight: 600; glow: scell.g; rim: root.deep; core: scell.g.mix(#ffffff, 0.6); }
                if scell.has: NeonText { x: 12px; y: 136px; width: scell.width - 24px; height: 22px; text: root.name(scell.t.label); size: 15px; weight: 600;
                    glow: scell.g; rim: root.deep; core: scell.g.mix(#ffffff, 0.45); }
                if !scell.has: Rectangle { x: (parent.width - 60px) / 2; y: 40px; width: 60px; height: 60px; border-radius: 30px; border-width: 1.5px; border-color: root.grid.with-alpha(0.7);
                    background: #00000059;
                    Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 28px; color: root.grid.mix(#ffffff, 0.5); } }
            }
        }
    }

    // ---------------------------------------------------------------- no timer: quick starts
    if !root.ringing && root.mode == 1 && (root.n == 0 || root.quick): Rectangle {
        background: root.n > 0 ? Theme.background : transparent;
        if root.n > 0: TouchArea { clicked => { Act.act("timers.quick-close", ""); } }
        Rectangle { x: (root.width - 80px) / 2; y: root.top + 18px; width: 80px; height: 80px; border-radius: 40px; background: TFg.c.with-alpha(0.05);
            Icon { width: parent.width; height: parent.height; text: "\u{F13AB}"; font-size: 42px; color: TFg.c.with-alpha(0.40); } }
        Text { x: 0; y: root.top + 106px; width: root.width; height: 24px; text: "No timers"; font-size: 17px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
        for m[i] in [1, 3, 5, 10, 15, 30]: Rectangle {
            x: 60px + Math.mod(i, 3) * 124px; y: root.top + 150px + Math.floor(i / 3) * 62px; width: 112px; height: 54px; border-radius: 27px;
            background: qs-touch.pressed ? TFg.c.with-alpha(0.2) : TFg.c.with-alpha(0.10);
            qs-touch := TouchArea { clicked => { Act.act("timers.start", m * 60); } }
            Text { width: parent.width; height: parent.height; text: m + " min"; font-size: 18px; font-weight: 600; color: TFg.c; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle { x: (root.width - 54px) / 2; y: root.top + 290px; width: 54px; height: 54px; border-radius: 27px; border-width: 1.5px; border-color: TFg.c.with-alpha(0.30);
            Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 26px; color: TFg.c.with-alpha(0.80); } }
    }

    // ---------------------------------------------------------------- alarms
    if !root.ringing && root.mode == 0: Rectangle {
        Rectangle { x: root.width - 20px - 44px; y: root.top; width: 44px; height: 44px; border-radius: 22px; border-width: 1.5px; border-color: TFg.c.with-alpha(0.30);
            Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 24px; color: TFg.c.with-alpha(0.80); } }
        Rectangle {
            x: 20px; y: root.top; width: root.width - 40px - 52px; height: 44px; border-radius: 22px; background: TFg.c.with-alpha(0.05);
            HorizontalLayout { alignment: center; spacing: 8px; padding-left: 12px; padding-right: 12px;
                Icon { text: "\u{F0020}"; font-size: 20px; color: root.next-tint; }
                Text { text: root.next-alarm != "" ? root.next-alarm : "No alarm on"; font-size: 15px; font-weight: 600; color: TFg.c.with-alpha(0.85); vertical-alignment: center; overflow: elide; }
            }
        }
        Flickable {
            x: 0; y: root.top + 56px; width: root.width; height: 448px - root.top - 56px;
            content-height: max(self.height, root.alarms.length * 78px);
        for a[i] in root.alarms: Rectangle {
            x: 20px; y: i * 78px; width: root.width - 40px; height: 70px; border-radius: 18px; background: TFg.c.with-alpha(0.04);
            Rectangle { x: 0; y: 14px; width: 4px; height: parent.height - 28px; border-radius: 2px; background: a.on ? a.tint : TFg.c.with-alpha(0.15); }
            Text { x: 18px; y: 0; width: 120px; height: parent.height; text: a.time; font-size: 34px; font-weight: 600; color: a.on ? TFg.c : TFg.c.with-alpha(0.35); vertical-alignment: center; }
            Text { x: 138px; y: 13px; width: parent.width - 138px - 80px; height: 22px; text: a.label; font-size: 16px; font-weight: 600; color: a.on ? a.tint.mix(TFg.c, 0.5) : TFg.c.with-alpha(0.35); overflow: elide; vertical-alignment: center; }
            Text { x: 138px; y: 35px; width: parent.width - 138px - 80px; height: 20px; text: a.days; font-size: 13px; color: a.on ? TFg.c.with-alpha(0.60) : TFg.c.with-alpha(0.25); overflow: elide; vertical-alignment: center; }
            Rectangle {
                x: parent.width - 72px; y: (parent.height - 30px) / 2; width: 54px; height: 30px; border-radius: 15px; background: a.on ? a.tint : TFg.c.with-alpha(0.15);
                TouchArea { x: -12px; y: -16px; width: parent.width + 24px; height: parent.height + 32px; clicked => { Act.act("alarms.toggle", i); } }
                Rectangle { x: a.on ? parent.width - 27px : 3px; y: 3px; width: 24px; height: 24px; border-radius: 12px; background: #ffffff; }
            }
        }
        }
        // more below: a soft fade above the page dots
        if root.alarms.length * 78px > 448px - root.top - 56px: Rectangle { x: 0; y: 448px - 34px; width: root.width; height: 34px;
            background: @linear-gradient(180deg, Theme.background.with-alpha(0) 0%, Theme.background 100%); }
    }

    // ---------------------------------------------------------------- stopwatch
    if !root.ringing && root.mode == 2: sw := Rectangle {
        property <int> cs: Math.mod(Math.floor(root.watch * 100), 100);
        property <string> main: root.watch >= 3600 ? Math.floor(root.watch / 3600) + ":" + root.two(Math.mod(Math.floor(root.watch / 60), 60)) + ":" + root.two(Math.mod(Math.floor(root.watch), 60))
            : Math.floor(root.watch / 60) + ":" + root.two(Math.mod(Math.floor(root.watch), 60));
        property <length> big: root.watch >= 3600 ? 60px : 76px;
        // the hundredths share the big digits' baseline (Noto Sans descent = 0.293 em)
        HorizontalLayout {
            x: 0; y: root.top + 30px; width: root.width; height: 92px; alignment: center; spacing: 2px;
            Text { text: sw.main; font-size: sw.big; font-weight: 600; color: TFg.c; vertical-alignment: bottom; }
            VerticalLayout { padding-bottom: (sw.big - 36px) * 0.293;
                Text { text: "." + root.two(sw.cs); font-size: 36px; font-weight: 600; color: TFg.c.with-alpha(0.50); vertical-alignment: bottom; } }
        }
        Text { x: 0; y: root.top + 124px; width: root.width; height: 20px; text: root.watch-running ? "Running" : root.watch > 0 ? "Stopped" : ""; font-size: 14px; color: TFg.c.with-alpha(0.50);
            horizontal-alignment: center; vertical-alignment: center; }
        for l[i] in root.laps: Rectangle {
            visible: i < 3;
            x: 40px; y: root.top + 156px + i * 34px; width: root.width - 80px; height: 30px;
            Text { x: 0; width: 100px; height: parent.height; text: "Lap " + (root.laps.length - i); font-size: 15px; color: TFg.c.with-alpha(0.60); vertical-alignment: center; }
            Text { x: parent.width - 140px; width: 140px; height: parent.height; text: (l >= 3600 ? Math.floor(l / 3600) + ":" + root.two(Math.mod(Math.floor(l / 60), 60)) : Math.floor(l / 60) + "") + ":" + root.two(Math.mod(Math.floor(l), 60)) + "." + root.two(Math.mod(Math.floor(l * 100), 100));
                font-size: 15px; font-weight: 600; color: TFg.c.with-alpha(0.85); horizontal-alignment: right; vertical-alignment: center; }
            Rectangle { y: parent.height - 1px; height: 1px; background: TFg.c.with-alpha(0.08); }
        }
        HorizontalLayout {
            x: 0; y: 362px; width: root.width; height: 72px; alignment: center; spacing: 22px;
            VerticalLayout { alignment: center; Pill { text: root.watch-running ? "Lap" : "Reset"; h: 48px; act: root.watch-running ? "watch.lap" : "watch.reset"; } }
            RoundButton { size: 72px; icon-size: 38px; fill: root.watch-tint; ink: #ffffff; icon: root.watch-running ? "\u{F03E4}" : "\u{F040A}"; act: "watch.toggle"; }
            VerticalLayout { alignment: center; RoundButton { size: 48px; icon-size: 24px; outline: true; icon: "\u{F023D}"; opacity: root.watch-running ? 1 : 0; act: root.watch-running ? "watch.lap" : ""; } }
        }
    }

    // ---------------------------------------------------------------- tabs (only the functions switched on)
    if !root.ringing && root.funcs > 1: HorizontalLayout {
        x: 0; y: 52px; width: root.width; height: 36px; alignment: center; spacing: 8px;
        for f[i] in [
            { k: 0, on: root.alarm-on, icon: "\u{F0020}", text: "Alarm", badge: 0 },
            { k: 1, on: root.timer-on, icon: "\u{F13AB}", text: "Timer", badge: root.n },
            { k: 2, on: root.watch-on, icon: "\u{F0150}", text: "Stopwatch", badge: 0 },
        ]: Rectangle {
            visible: f.on;
            width: f.on ? tt.preferred-width + 54px + (f.badge > 0 ? 24px : 0px) : 0px; height: 36px; border-radius: 18px;
            TouchArea { clicked => { Act.act("timers.mode", f.k); } }
            background: f.k == root.mode ? (root.synth ? #00000080 : TFg.c.with-alpha(0.15)) : (root.synth ? #00000047 : transparent);
            border-width: f.k == root.mode ? 0px : 1px; border-color: root.synth ? root.grid.with-alpha(0.45) : TFg.c.with-alpha(0.18);
            Icon { x: 12px; y: 0; width: 22px; height: parent.height; text: f.icon; font-size: 18px; color: root.synth ? (f.k == root.mode ? #ffffff : #ffffffa6) : (f.k == root.mode ? TFg.c : TFg.c.with-alpha(0.65)); }
            tt := Text { x: 38px; y: 0; width: self.preferred-width; height: parent.height; text: f.text; font-size: 14px; font-weight: 600; color: root.synth ? (f.k == root.mode ? #ffffff : #ffffffa6) : (f.k == root.mode ? TFg.c : TFg.c.with-alpha(0.65)); vertical-alignment: center; }
            if f.badge > 0: Rectangle { x: 38px + tt.preferred-width + 6px; y: 8px; width: 20px; height: 20px; border-radius: 10px; background: root.synth ? #ffffff : TFg.c;
                Text { width: parent.width; height: parent.height; text: f.badge; font-size: 12px; font-weight: 700; color: root.synth || Theme.dark ? #111113 : #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
        }
    }

    // ---------------------------------------------------------------- ringing: full screen until stop
    if root.ringing: Rectangle {
        background: @radial-gradient(circle, root.ring-tint.mix(#000000, 0.55 + 0.25 * root.pulse) 0%, root.ring-tint.mix(#000000, 0.22) 100%);
        if !root.ring-alarm: Rectangle { x: (root.width - 112px) / 2; y: 70px; width: 112px; height: 112px; border-radius: 56px; background: #ffffff26;
            Icon { width: parent.width; height: parent.height; text: "\u{F13AB}"; font-size: 60px; color: #ffffff; } }
        if root.ring-alarm: Text { x: 0; y: 60px; width: root.width; height: 130px; text: root.ring-time; font-size: 112px; font-weight: 700; color: #ffffff;
            horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 24px; y: 204px; width: root.width - 48px; height: 46px; text: root.ring-alarm ? root.ring-label : root.name(root.ring-label); font-size: 34px; font-weight: 700; color: #ffffff;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Text { x: 0; y: 250px; width: root.width; height: 26px; text: root.ring-alarm ? "Good morning" : "Time's up  ·  +" + root.clock(root.ring-over); font-size: 18px; color: #ffffffcc;
            horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { x: (root.width - 220px) / 2; y: 312px; width: 220px; height: 64px; border-radius: 32px; background: #ffffff;
            Text { width: parent.width; height: parent.height; text: "Stop"; font-size: 22px; font-weight: 700; color: root.ring-tint.mix(#000000, 0.6); horizontal-alignment: center; vertical-alignment: center; } }
        Rectangle { x: (root.width - 140px) / 2; y: 392px; width: 140px; height: 44px; border-radius: 22px; background: #ffffff2e;
            Text { width: parent.width; height: parent.height; text: root.ring-alarm ? "Snooze 9 min" : "+1 min"; font-size: 16px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
    }

    // ---------------------------------------------------------------- alarm editor: time, days, sound, label
    // (a sheet sized to its content, under the status bar; delete sits in the header for a saved alarm)
    if root.edit && !root.edit-keyboard: Rectangle { background: #00000080; }
    if root.edit && !root.edit-keyboard: ed := Rectangle {
        property <bool> ha: root.edit-ha-sound != "";
        property <length> dy: 56px;                       // drums
        property <length> ty: self.dy + 120px + 14px;     // days
        property <length> sy: self.ty + 40px + 18px;      // sounds (two lines, a third for the one set in Home Assistant)
        property <length> ly: self.sy + (self.ha ? 112px : 72px) + 18px;      // label
        x: 0; y: root.height - self.height; width: root.width; height: self.ly + 44px + 14px;
        border-top-left-radius: 24px; border-top-right-radius: 24px; background: Theme.sheet;
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: TFg.c.with-alpha(0.25); }
        Text { x: 20px; y: 16px; height: 32px; text: root.edit-new ? "New alarm" : "Edit alarm"; font-size: 20px; font-weight: 600; color: TFg.c; vertical-alignment: center; }
        if !root.edit-new: Rectangle { x: parent.width - 16px - 88px - 46px - 46px; y: 14px; width: 36px; height: 36px; border-radius: 18px; border-width: 1px; border-color: #ff5a5f80;
            Icon { width: parent.width; height: parent.height; text: "\u{F01B4}"; font-size: 20px; color: #ff7a7e; } }
        Rectangle { x: parent.width - 16px - 88px - 46px; y: 14px; width: 36px; height: 36px; border-radius: 18px; background: TFg.c.with-alpha(0.12);
            Icon { width: parent.width; height: parent.height; text: "\u{F0156}"; font-size: 21px; color: TFg.c.with-alpha(0.90); } }
        Rectangle { x: parent.width - 16px - 88px; y: 15px; width: 88px; height: 34px; border-radius: 17px; background: root.edit-tint;
            Text { width: parent.width; height: parent.height; text: "Save"; font-size: 15px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
        // time: two drums, the middle row is the value
        Rectangle { x: 72px; y: ed.dy + 40px; width: parent.width - 144px; height: 40px; border-radius: 14px; background: TFg.c.with-alpha(0.07); }
        for col[ci] in [{ v: root.edit-h, n: 24, x: 118 }, { v: root.edit-m, n: 60, x: 256 }]: Rectangle {
            for r in [-1, 0, 1]: Text {
                property <int> val: Math.mod(col.v + r + col.n * 2, col.n);
                x: col.x * 1px; y: ed.dy + 40px + r * 40px; width: 106px; height: 40px;
                text: ci == 0 ? "" + self.val : root.two(self.val);
                font-size: r == 0 ? 38px : 24px; font-weight: r == 0 ? 600 : 500;
                color: r == 0 ? TFg.c : TFg.c.with-alpha(0.35); horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Text { x: 0; y: ed.dy + 40px; width: parent.width; height: 40px; text: ":"; font-size: 36px; font-weight: 600; color: TFg.c; horizontal-alignment: center; vertical-alignment: center; }
        // days
        HorizontalLayout {
            x: 16px; y: ed.ty; width: parent.width - 32px; height: 40px; alignment: space-between;
            for d[i] in ["M", "T", "W", "T", "F", "S", "S"]: Rectangle {
                width: 54px; height: 40px; border-radius: 20px;
                background: root.edit-days[i] ? root.edit-tint : transparent; border-width: root.edit-days[i] ? 0px : 1px; border-color: TFg.c.with-alpha(0.25);
                Text { width: parent.width; height: parent.height; text: d; font-size: 15px; font-weight: 600; color: root.edit-days[i] ? #ffffff : TFg.c.with-alpha(0.70); horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // sound: the built-in ones (a tap plays it), the info button, the one set in Home Assistant
        HorizontalLayout {
            x: 16px; y: ed.sy; height: 32px; alignment: start; spacing: 6px;
            for s[i] in [root.sounds[0], root.sounds[1], root.sounds[2]]: Chip { text: s; on: root.edit-sound == i; fill: root.edit-tint; }
            Rectangle { width: 32px; height: 32px; border-radius: 16px; background: root.edit-info ? TFg.c.with-alpha(0.18) : TFg.c.with-alpha(0.08);
                Icon { width: parent.width; height: parent.height; text: "\u{F02FD}"; font-size: 18px; color: TFg.c.with-alpha(0.80); } }
        }
        HorizontalLayout {
            x: 16px; y: ed.sy + 40px; height: 32px; alignment: start; spacing: 6px;
            for s[i] in [root.sounds[3], root.sounds[4], root.sounds[5]]: Chip { text: s; on: root.edit-sound == i + 3; fill: root.edit-tint; }
        }
        if ed.ha: Rectangle {
            x: 16px; y: ed.sy + 80px; width: min(hs.preferred-width + 48px, parent.width - 32px); height: 32px; border-radius: 16px;
            background: root.edit-sound == root.sounds.length ? root.edit-tint : transparent; border-width: root.edit-sound == root.sounds.length ? 0px : 1px; border-color: TFg.c.with-alpha(0.25);
            Icon { x: 12px; width: 18px; height: parent.height; text: "\u{F07D0}"; font-size: 16px; color: root.edit-sound == root.sounds.length ? #ffffff : TFg.c; }
            hs := Text { x: 34px; width: parent.width - 48px; height: parent.height; text: root.edit-ha-sound; font-size: 14px; font-weight: 500; color: root.edit-sound == root.sounds.length ? #ffffff : TFg.c; vertical-alignment: center; overflow: elide; }
        }
        // label: a tap opens the keyboard
        Rectangle {
            x: 16px; y: ed.ly; width: parent.width - 32px; height: 44px; border-radius: 14px; background: TFg.c.with-alpha(0.07);
            Icon { x: 14px; width: 22px; height: parent.height; text: "\u{F04F9}"; font-size: 19px; color: TFg.c.with-alpha(0.60); }
            Text { x: 46px; width: parent.width - 60px; height: parent.height; text: root.edit-label != "" ? root.edit-label : "Label"; font-size: 16px;
                color: root.edit-label != "" ? TFg.c : TFg.c.with-alpha(0.40); vertical-alignment: center; overflow: elide; }
        }
        // the info note: where the other sounds come from
        if root.edit-info: Rectangle {
            x: 16px; y: ed.sy - 96px; width: parent.width - 32px; height: 88px; border-radius: 16px; background: Theme.dark ? #2c2c32 : #e9e6df;
            border-width: 1px; border-color: TFg.c.with-alpha(0.12);
            Text { x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 24px; wrap: word-wrap; font-size: 14px; color: TFg.c.with-alpha(0.85); vertical-alignment: center;
                text: "Music from Music Assistant or a sound of your own: pick it for this alarm in Home Assistant and it shows up here."; }
        }
    }
    // label keyboard (the same block as on the setup screens)
    if root.edit && root.edit-keyboard: Rectangle {
        background: Theme.background;
        Text { x: 20px; y: 52px; height: 34px; text: "Alarm label"; font-size: 20px; font-weight: 600; color: TFg.c; vertical-alignment: center; }
        Rectangle { x: parent.width - 16px - 88px; y: 52px; width: 88px; height: 34px; border-radius: 17px; background: root.edit-tint;
            Text { width: parent.width; height: parent.height; text: "Done"; font-size: 15px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
        Rectangle {
            x: 16px; y: 100px; width: parent.width - 32px; height: 52px; border-radius: 14px; background: TFg.c.with-alpha(0.07); border-width: 1.5px; border-color: root.edit-tint;
            lt := Text { x: 16px; width: min(self.preferred-width, parent.width - 70px); height: parent.height; text: root.edit-label; font-size: 18px; color: TFg.c; vertical-alignment: center; overflow: elide; }
            Rectangle { x: 16px + lt.width + 2px; y: 14px; width: 2px; height: 24px; background: root.edit-tint; }
            if root.edit-label != "": Rectangle { x: parent.width - 44px; y: 8px; width: 36px; height: 36px; border-radius: 18px;
                Icon { width: parent.width; height: parent.height; text: "\u{F0159}"; font-size: 20px; color: TFg.c.with-alpha(0.50); } }
        }
        Text { x: 20px; y: 162px; width: parent.width - 40px; height: 20px; text: root.edit-h + ":" + root.two(root.edit-m) + "  ·  " + root.sounds[min(root.edit-sound, root.sounds.length - 1)];
            font-size: 13px; color: TFg.c.with-alpha(0.50); vertical-alignment: center; overflow: elide; }
        Keyboard { x: Theme.pad; y: Theme.keyboard-top; width: root.width - 2 * Theme.pad; layer: root.kb-layer; enter-label: "Done"; accent: root.edit-tint; }
    }

    // ---------------------------------------------------------------- settings: functions, colour, theme (+ scene)
    if root.settings: Rectangle { background: #00000080; }
    if root.settings: st := Rectangle {
        property <bool> scenes: root.theme == 3;
        property <length> r0: 72px;
        property <length> r1: self.r0 + 32px + 22px;
        property <length> r2: self.r1 + 32px + 22px;
        property <length> r3: self.r2 + 32px + 8px + 32px + 22px;
        x: 0; y: root.height - self.height; width: root.width;
        height: (st.scenes ? self.r3 + 32px + 8px + 32px : self.r2 + 32px + 8px + 32px) + 24px;
        border-top-left-radius: 24px; border-top-right-radius: 24px;
        background: Theme.sheet;
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: TFg.c.with-alpha(0.25); }
        Text { x: 20px; y: 22px; text: "Alarms & timers"; font-size: 20px; font-weight: 600; color: TFg.c; }
        Rectangle { x: parent.width - 16px - 88px - 46px; y: 18px; width: 36px; height: 36px; border-radius: 18px; background: TFg.c.with-alpha(0.12);
            Icon { width: parent.width; height: parent.height; text: "\u{F02FD}"; font-size: 21px; color: TFg.c.with-alpha(0.90); } }
        Rectangle { x: parent.width - 16px - 88px; y: 19px; width: 88px; height: 34px; border-radius: 17px; background: Theme.text;
            Text { width: parent.width; height: parent.height; text: "Done"; font-size: 15px; font-weight: 600; color: Theme.background; horizontal-alignment: center; vertical-alignment: center; } }
        HorizontalLayout {
            x: 16px; y: st.r0; height: 32px; alignment: start; spacing: 6px;
            Chip { text: "Alarm"; on: root.alarm-on; check: true; }
            Chip { text: "Timer"; on: root.timer-on; check: true; }
            Chip { text: "Stopwatch"; on: root.watch-on; check: true; }
        }
        HorizontalLayout {
            x: 16px; y: st.r1; height: 32px; alignment: start; spacing: 6px;
            Chip { text: "Flying Colours"; on: root.colourful; }
            for c in [#ff3d6e, #ffb21e, #22d3a6, #3d9bff, #a76bff]: VerticalLayout { alignment: center;
                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: c; opacity: root.colourful ? 1 : 0.35; } }
            Rectangle { width: 10px; }
            Chip { text: "One Shade"; on: !root.colourful; }
            VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; opacity: root.colourful ? 0.35 : 1; } }
        }
        HorizontalLayout {
            x: 16px; y: st.r2; height: 32px; alignment: start; spacing: 6px;
            Chip { text: "Full Circle"; on: root.theme == 0; }
            Chip { text: "Done to a Turn"; on: root.theme == 1; }
            Chip { text: "Sands of Time"; on: root.theme == 2; }
        }
        HorizontalLayout {
            x: 16px; y: st.r2 + 40px; height: 32px; alignment: start; spacing: 6px;
            Chip { text: "In the Fast Lane"; on: root.theme == 3; }
            Chip { text: "Flip Side"; on: root.theme == 4; }
        }
        if st.scenes: HorizontalLayout {
            x: 16px; y: st.r3; height: 32px; alignment: start; spacing: 6px;
            Chip { text: "Surprise Me"; on: root.sw-choice < 0; }
            Chip { text: "Ride into the Sunset"; on: root.sw-choice == 0; }
            Chip { text: "Concrete Jungle"; on: root.sw-choice == 1; }
        }
        if st.scenes: HorizontalLayout {
            x: 16px; y: st.r3 + 40px; height: 32px; alignment: start; spacing: 6px;
            Chip { text: "Life's a Beach"; on: root.sw-choice == 2; }
            Chip { text: "Starry-Eyed"; on: root.sw-choice == 3; }
        }
    }
}
